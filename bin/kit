#!/usr/bin/env python3
"""agent-board-kit installer and health check.

    kit install [--env FILE] [--role desktop|mac] [--dry-run] [--only STEP,...] [--skip STEP,...]
                [--start] [--labels] [--force] [--allow-example]
    kit doctor  [--env FILE] [--role desktop|mac] [--online]
    kit render  TEMPLATE [--env FILE]          print one template rendered with your values
    kit uninstall [--dry-run]                  remove what install added (wrappers, units, blocks)

Everything personal comes from one file, ~/.config/agent-kit/kit.env (copied from
kit.example.env on the first run). Every step is idempotent: re-run it after editing kit.env or
pulling a new version of the kit. Nothing is started, and nothing is written to GitHub, unless
you ask (--start, --labels). Existing files are backed up before they are changed.

Steps, in order (desktop role): config venv wrappers configs instructions hooks orchestrator
general-repo systemd cron. The mac role runs: config venv wrappers configs instructions hooks.
Stdlib only, Python 3.9+.
"""
import argparse
import datetime
import json
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

KIT_DIR = Path(__file__).resolve().parent.parent
HOME = Path.home()
CONF_DIR = HOME / ".config" / "agent-kit"
DEFAULT_ENV = CONF_DIR / "kit.env"
VENV = HOME / ".local" / "share" / "agent-kit" / "venv"
BIN_DIR = HOME / ".local" / "bin"
UNIT_DIR = HOME / ".config" / "systemd" / "user"
INSTRUCTIONS = CONF_DIR / "AGENTS.agents.md"
MARK = "agent-board-kit"
WRAPPER_MARK = "# agent-board-kit wrapper"
BLOCK_BEGIN = "<!-- agent-board-kit:begin (generated by kit install; edit kit.env, not this block) -->"
BLOCK_END = "<!-- agent-board-kit:end -->"
CLAUDE_INCLUDE = "@~/.config/agent-kit/AGENTS.agents.md"

REQUIRED = ["OWNER_NAME", "OWNER_EMAIL", "AGENT_EMAIL", "AGENT_FROM_NAME", "GITHUB_OWNER", "TASKS_REPO",
            "REPOS_ROOT", "GENERAL_REPO", "ORCHESTRATOR_DIR", "HOST_ID", "DESKTOP_HOST"]
OPTIONAL = {"MAC_HOST": "", "WITH_MEMWATCH": "yes", "WITH_RESTART": "yes", "WITH_CLOUD_WATCHDOG": "no",
            "WITH_TODO_DISPATCH": "yes"}
EXAMPLE_VALUES = {"alex@example.com", "yourname.agents@gmail.com", "alex-gh", "alex-gh/tasks"}
DESKTOP_STEPS = ["config", "venv", "wrappers", "configs", "instructions", "hooks", "orchestrator",
                 "general-repo", "systemd", "cron"]
MAC_STEPS = ["config", "venv", "wrappers", "configs", "instructions", "hooks"]


# ---------------------------------------------------------------------------------------------- utils

class Ctx:
    def __init__(self, args):
        self.dry = getattr(args, "dry_run", False)
        self.force = getattr(args, "force", False)
        self.changes = []
        self.warnings = []
        self.stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")

    def say(self, msg):
        print(("[dry-run] " if self.dry else "") + msg)

    def warn(self, msg):
        self.warnings.append(msg)
        print("WARNING: " + msg)

    def write(self, path, text, mode=None, backup=True):
        """Write text if it differs; back up a file we are about to change. Returns True if changed."""
        path = Path(path)
        old = path.read_text() if path.exists() else None
        if old == text:
            return False
        self.changes.append(str(path))
        if self.dry:
            self.say("would write %s%s" % (path, " (changed)" if old is not None else " (new)"))
            return True
        path.parent.mkdir(parents=True, exist_ok=True)
        if old is not None and backup:
            bak = path.with_name(path.name + ".bak-" + self.stamp)
            shutil.copy2(str(path), str(bak))
            self.say("backed up %s -> %s" % (path, bak.name))
        path.write_text(text)
        if mode is not None:
            os.chmod(str(path), mode)
        self.say("wrote %s" % path)
        return True

    def run(self, cmd, **kw):
        self.say("run: " + " ".join(shlex.quote(str(c)) for c in cmd))
        if self.dry:
            return subprocess.CompletedProcess(cmd, 0, "", "")
        return subprocess.run([str(c) for c in cmd], text=True, capture_output=True, **kw)


def expand(v):
    return os.path.expanduser(v) if isinstance(v, str) else v


def parse_env(path):
    env = {}
    for n, line in enumerate(Path(path).read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:]
        m = re.match(r"^([A-Z_][A-Z0-9_]*)=(.*)$", line)
        if not m:
            raise SystemExit("%s:%d: cannot parse %r (expected KEY=\"value\")" % (path, n, line))
        k, v = m.group(1), m.group(2).strip()
        if v[:1] in "\"'":
            parts = shlex.split(v)
            v = parts[0] if parts else ""
        else:
            v = v.split(" #")[0].strip()
        env[k] = v
    return env


def load_env(path, allow_example=False, quiet=False):
    env = dict(OPTIONAL)
    env.update(parse_env(path))
    missing = [k for k in REQUIRED if not env.get(k)]
    if missing:
        raise SystemExit("%s: missing values for %s" % (path, ", ".join(missing)))
    if not allow_example:
        left = [k for k in REQUIRED if env[k] in EXAMPLE_VALUES]
        if left:
            raise SystemExit("%s still has the example values for %s. Edit it first." % (path, ", ".join(left)))
    for k in ("OWNER_EMAIL", "AGENT_EMAIL"):
        if not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", env[k]):
            raise SystemExit("%s: %s=%r is not an email address" % (path, k, env[k]))
    if env["OWNER_EMAIL"].lower() == env["AGENT_EMAIL"].lower():
        raise SystemExit("%s: OWNER_EMAIL and AGENT_EMAIL must be different accounts" % path)
    if not re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", env["TASKS_REPO"]):
        raise SystemExit("%s: TASKS_REPO must look like owner/name" % path)
    for k in ("REPOS_ROOT", "GENERAL_REPO", "ORCHESTRATOR_DIR"):
        env[k + "_PATH"] = Path(expand(env[k]))
    return env


def yes(env, key):
    return str(env.get(key, "")).strip().lower() in ("1", "y", "yes", "true", "on")


def python_for(env, role):
    vpy = VENV / "bin" / "python"
    if vpy.exists() or env.get("_venv_planned"):
        return str(vpy)
    return "/usr/bin/env python3"


def placeholders(env, role):
    ph = {k: env[k] for k in REQUIRED}
    ph["MAC_HOST"] = env.get("MAC_HOST") or "mac"
    ph["KIT_DIR"] = str(KIT_DIR)
    ph["PYTHON"] = python_for(env, role)
    ph["BIN_DIR"] = str(BIN_DIR)
    return ph


def render(text, ph, where="template"):
    out = re.sub(r"\{\{([A-Z_]+)\}\}", lambda m: ph.get(m.group(1), m.group(0)), text)
    left = sorted(set(re.findall(r"\{\{[A-Z_]+\}\}", out)))
    if left:
        raise SystemExit("%s: unknown placeholders %s" % (where, ", ".join(left)))
    return out


def components(env, role):
    comps = ["mailroom"]
    if role == "desktop":
        comps += ["board", "todo"]
        if yes(env, "WITH_CLOUD_WATCHDOG"):
            comps.append("cloud-watchdog")
    return [c for c in comps if (KIT_DIR / c).is_dir()]


def tools(env, role):
    """(name, script path) for every command-line tool of the enabled components."""
    out = []
    skip = set()
    if not yes(env, "WITH_RESTART"):
        skip.add("agent-restart")
    if not yes(env, "WITH_MEMWATCH"):
        skip.add("agent-memwatch")
    if role == "mac":                                   # server-side tools: they run on the Linux machine
        skip.update({"agent-mailroom", "agent-memwatch", "agent-failover", "agent-orchestrate"})
    for comp in components(env, role):
        bdir = KIT_DIR / comp / "bin"
        if not bdir.is_dir():
            continue
        for p in sorted(bdir.iterdir()):
            if p.is_file() and os.access(str(p), os.X_OK) and p.name not in skip and not p.name.startswith("."):
                out.append((p.name, p))
    auth = KIT_DIR / "mailroom" / "agent_mail_auth.py"
    if role == "desktop" and auth.exists():
        out.append(("agent-mail-auth", auth))
    out.append(("kit", KIT_DIR / "bin" / "kit"))
    return out


def is_python_script(path):
    try:
        with open(str(path), "rb") as f:
            first = f.readline()
    except OSError:
        return False
    return path.suffix == ".py" or b"python" in first


# ---------------------------------------------------------------------------------------------- steps

def step_config(ctx, env, role, args):
    ctx.say("config: %s (role %s, kit %s)" % (args.env, role, KIT_DIR))
    for k in ("OWNER_NAME", "OWNER_EMAIL", "AGENT_EMAIL", "GITHUB_OWNER", "TASKS_REPO", "REPOS_ROOT"):
        print("  %-16s %s" % (k, env[k]))


def step_venv(ctx, env, role, args):
    req = [KIT_DIR / c / "requirements.txt" for c in components(env, role)]
    req = [r for r in req if r.exists()]
    py = VENV / "bin" / "python"
    if not py.exists():
        r = ctx.run([sys.executable, "-m", "venv", str(VENV)])
        if r.returncode != 0:
            raise SystemExit("could not create the venv at %s: %s\n(on Ubuntu: sudo apt install python3-venv)"
                             % (VENV, (r.stderr or "").strip()[-400:]))
    if req:
        cmd = [str(py), "-m", "pip", "install", "--quiet", "--upgrade"]
        for r in req:
            cmd += ["-r", str(r)]
        r = ctx.run(cmd)
        if r.returncode != 0:
            raise SystemExit("pip install failed:\n" + (r.stderr or "")[-1500:])
    env["_venv_planned"] = True


def wrapper_text(env, role, script):
    py = python_for(env, role)
    if is_python_script(script):
        target = ("exec %s %s \"$@\"" % (shlex.quote(py), shlex.quote(str(script)))) if not py.startswith("/usr/bin/env") \
            else ("exec /usr/bin/env python3 %s \"$@\"" % shlex.quote(str(script)))
    else:
        target = "exec %s \"$@\"" % shlex.quote(str(script))
    return "#!/usr/bin/env bash\n%s (generated by kit install; re-run it to update, safe to delete)\n%s\n" % (
        WRAPPER_MARK, target)


def step_wrappers(ctx, env, role, args):
    for name, script in tools(env, role):
        dest = BIN_DIR / name
        if (dest.exists() or dest.is_symlink()) and not _is_wrapper(dest):
            if not ctx.force:
                ctx.warn("%s exists and is not a kit wrapper; left alone (use --force to replace it, a backup is kept)"
                         % dest)
                continue
            if not ctx.dry:
                bak = dest.with_name(dest.name + ".bak-" + ctx.stamp)
                os.replace(str(dest), str(bak))
                ctx.say("moved %s -> %s" % (dest, bak.name))
        ctx.write(dest, wrapper_text(env, role, script), mode=0o755, backup=False)
    if str(BIN_DIR) not in os.environ.get("PATH", "").split(os.pathsep):
        ctx.warn("%s is not on PATH; add it in ~/.profile (export PATH=\"$HOME/.local/bin:$PATH\")" % BIN_DIR)


def _is_wrapper(path):
    try:
        return path.is_file() and not path.is_symlink() and WRAPPER_MARK in path.read_text()[:300]
    except (OSError, UnicodeDecodeError):
        return False


def _load_json(path):
    path = Path(path)
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text() or "{}")
    except ValueError as e:
        raise SystemExit("%s is not valid JSON (%s); fix or move it, then re-run" % (path, e))


def mailroom_config(env, role, cur):
    cfg = dict(cur)
    cfg.update({
        "account": env["AGENT_EMAIL"].lower(),
        "from_name": env["AGENT_FROM_NAME"],
        "owner_name": env["OWNER_NAME"],
        "owner_email": env["OWNER_EMAIL"].lower(),
        "github_owner": env["GITHUB_OWNER"],
        "repos_root": env["REPOS_ROOT"],
        "general_repo": env["GENERAL_REPO"],
        "orchestrator_dir": env["ORCHESTRATOR_DIR"],
    })
    allow = [a.lower() for a in (cur.get("allowlist") or [])]
    if env["OWNER_EMAIL"].lower() not in allow:
        allow.insert(0, env["OWNER_EMAIL"].lower())
    cfg["allowlist"] = allow
    remote = dict(cur.get("remote_hosts") or {})
    if role == "desktop":
        cfg["host_id"] = env["HOST_ID"]
        if env.get("MAC_HOST"):
            remote["mac"] = env["MAC_HOST"]
            rec = list(cur.get("recovery_hosts") or [])
            if "mac" not in rec:
                rec.append("mac")
            cfg["recovery_hosts"] = rec
    else:
        cfg["host_id"] = "mac"
        cfg["mail_proxy"] = env["HOST_ID"]              # a host id (key of remote_hosts), not an ssh alias
        cfg["send_enabled"] = False
        remote[env["HOST_ID"]] = env["DESKTOP_HOST"]
    cfg["remote_hosts"] = remote
    return cfg


def step_configs(ctx, env, role, args):
    path = HOME / ".config" / "agent-mail" / "config.json"
    cfg = mailroom_config(env, role, _load_json(path))
    ctx.write(path, json.dumps(cfg, indent=2, sort_keys=True) + "\n", mode=0o600)
    if not ctx.dry:
        os.chmod(str(path.parent), 0o700)
    if role != "desktop":
        return
    tpath = HOME / ".config" / "todo-desk" / "config.json"
    tcfg = _load_json(tpath)
    tcfg.update({"repo": env["TASKS_REPO"], "owner_name": env["OWNER_NAME"], "owner_email": env["OWNER_EMAIL"].lower(),
                 "repos_root": env["REPOS_ROOT"], "general_repo": env["GENERAL_REPO"]})
    ctx.write(tpath, json.dumps(tcfg, indent=2, sort_keys=True) + "\n")
    bpath = HOME / ".config" / "agent-board" / "config.json"
    if not bpath.exists():
        ctx.write(bpath, "{}\n")


def rendered_instructions(env, role):
    ph = placeholders(env, role)
    text = render((KIT_DIR / "templates" / "AGENTS.agents.md").read_text(), ph, "templates/AGENTS.agents.md")
    snippet = KIT_DIR / "cloud-watchdog" / "docs" / "agents-snippet.md"
    if yes(env, "WITH_CLOUD_WATCHDOG") and snippet.exists():
        text = text.rstrip("\n") + "\n\n" + render(snippet.read_text(), ph, str(snippet)).strip("\n") + "\n"
    return text


def replace_block(old, inner):
    block = "%s\n%s\n%s\n" % (BLOCK_BEGIN, inner.strip("\n"), BLOCK_END)
    if BLOCK_BEGIN in old and BLOCK_END in old:
        pre, rest = old.split(BLOCK_BEGIN, 1)
        post = rest.split(BLOCK_END, 1)[1].lstrip("\n")
        return pre + block + post
    return (old.rstrip("\n") + "\n\n" if old.strip() else "") + block


def step_instructions(ctx, env, role, args):
    text = rendered_instructions(env, role)
    ctx.write(INSTRUCTIONS, text)
    claude_md = HOME / ".claude" / "CLAUDE.md"
    cur = claude_md.read_text() if claude_md.exists() else ""
    if CLAUDE_INCLUDE not in cur:
        new = (cur.rstrip("\n") + "\n\n" if cur.strip() else "") + \
            "## Agent mail, status notes and the orchestrator (agent-board-kit)\n\n%s\n" % CLAUDE_INCLUDE
        ctx.write(claude_md, new)
    codex_md = HOME / ".codex" / "AGENTS.md"
    if (HOME / ".codex").is_dir() or shutil.which("codex"):
        cur = codex_md.read_text() if codex_md.exists() else ""
        ctx.write(codex_md, replace_block(cur, text))
    else:
        ctx.say("codex not found; skipped ~/.codex/AGENTS.md (re-run after installing Codex)")


def merge_hooks(cur, frag):
    """Add each hook group of frag whose command is not already present for that event. Returns new dict."""
    out = json.loads(json.dumps(cur))
    hooks = out.setdefault("hooks", {})
    for event, groups in frag.get("hooks", {}).items():
        have = hooks.setdefault(event, [])
        present = {(g.get("matcher"), h.get("command")) for g in have for h in g.get("hooks", [])}
        for g in groups:
            if all((g.get("matcher"), h.get("command")) in present for h in g.get("hooks", [])):
                continue
            have.append(g)
    for k, v in frag.items():
        if k != "hooks":
            out[k] = v
    return out


def step_hooks(ctx, env, role, args):
    frag = json.loads((KIT_DIR / "templates" / "claude-settings.fragment.json").read_text())
    path = HOME / ".claude" / "settings.json"
    cur = _load_json(path)
    if cur.get("crossSessionInbound") not in (None, "accept"):
        ctx.warn("~/.claude/settings.json had crossSessionInbound=%r; the mailroom needs \"accept\""
                 % cur.get("crossSessionInbound"))
    new = merge_hooks(cur, frag)
    if new != cur:
        ctx.write(path, json.dumps(new, indent=2) + "\n")
    if (HOME / ".codex").is_dir() or shutil.which("codex"):
        cfrag = json.loads((KIT_DIR / "templates" / "codex-hooks.fragment.json").read_text())
        cpath = HOME / ".codex" / "hooks.json"
        ccur = _load_json(cpath)
        cnew = merge_hooks(ccur, cfrag)
        if cnew != ccur:
            ctx.write(cpath, json.dumps(cnew, indent=2) + "\n")
            ctx.say("Codex asks you to review and trust new hooks the next time it starts: accept them.")


def _git(ctx, cwd, *a):
    ident = []
    r = subprocess.run(["git", "config", "--global", "user.email"], capture_output=True, text=True)
    if not r.stdout.strip():
        ident = ["-c", "user.name=agent-kit", "-c", "user.email=agent-kit@localhost"]
    r = ctx.run(["git"] + ident + list(a))
    if r.returncode != 0:
        ctx.warn("git %s failed: %s" % (" ".join(a[2:3]), (r.stderr or "").strip()[-200:]))
    return r


def step_orchestrator(ctx, env, role, args):
    ph = placeholders(env, role)
    src = KIT_DIR / "orchestrator"
    dest = env["ORCHESTRATOR_DIR_PATH"]
    fresh = not dest.exists()
    for p in sorted(src.rglob("*")):
        if p.is_dir() or "__pycache__" in p.parts:
            continue
        rel = p.relative_to(src)
        target = dest / rel
        text = render(p.read_text(), ph, "orchestrator/%s" % rel)
        section = KIT_DIR / "cloud-watchdog" / "docs" / "orchestrator-section.md"
        if str(rel) == "AGENTS.md" and yes(env, "WITH_CLOUD_WATCHDOG") and section.exists():
            text = text.rstrip("\n") + "\n\n" + render(section.read_text(), ph, str(section)).strip("\n") + "\n"
        if target.exists() and rel.name == "STATE.md":
            continue                                   # its memory: never overwritten
        if target.exists() and target.read_text() != text and not ctx.force:
            ctx.warn("%s differs from the kit's version; left alone (re-run with --force to update it)" % target)
            continue
        ctx.write(target, text)
    if fresh or not (dest / ".git").exists():
        _git(ctx, dest, "-C", str(dest), "init", "-q", "-b", "main")
        _local_identity(ctx, dest)
        _git(ctx, dest, "-C", str(dest), "add", "-A")
        _git(ctx, dest, "-C", str(dest), "commit", "-q", "-m", "orchestrator: initial brief and state")
    else:
        _local_identity(ctx, dest)


def _local_identity(ctx, repo):
    """Each orchestrator run commits STATE.md: if git has no effective identity there, give the repo its own."""
    if ctx.dry:
        return
    for key, value in (("user.name", "orchestrator"), ("user.email", "orchestrator@localhost")):
        r = subprocess.run(["git", "-C", str(repo), "config", key], capture_output=True, text=True)
        if not r.stdout.strip():
            subprocess.run(["git", "-C", str(repo), "config", key, value], capture_output=True)


def step_general_repo(ctx, env, role, args):
    dest = env["GENERAL_REPO_PATH"]
    if dest.exists():
        return
    ctx.write(dest / "README.md", "# %s\n\nA home for agent work that belongs to no project: research, notes, errands.\n"
              % dest.name)
    _git(ctx, dest, "-C", str(dest), "init", "-q", "-b", "main")
    _git(ctx, dest, "-C", str(dest), "add", "-A")
    _git(ctx, dest, "-C", str(dest), "commit", "-q", "-m", "initial commit")
    ctx.say("created %s as a local repo. To back it up: cd %s && gh repo create %s --private --source . --push"
            % (dest, dest, dest.name))


def units(env):
    """(component, unit file) for every systemd unit the enabled options want."""
    want = []
    for comp in components(env, "desktop"):
        sdir = KIT_DIR / comp / "systemd"
        if not sdir.is_dir():
            continue
        for p in sorted(sdir.iterdir()):
            if p.suffix not in (".in", ".service", ".timer"):
                continue
            name = p.name[:-3] if p.name.endswith(".in") else p.name
            if "memwatch" in name and not yes(env, "WITH_MEMWATCH"):
                continue
            if "restart" in name and not yes(env, "WITH_RESTART"):
                continue
            if "dispatch" in name and not yes(env, "WITH_TODO_DISPATCH"):
                continue
            want.append((comp, p, name))
    return want


DEFAULT_ENABLE = ("agent-mailroom.service", "agent-memwatch.service", "agent-restart-restore.service")


def step_systemd(ctx, env, role, args):
    if platform.system() != "Linux":
        ctx.say("not Linux: skipped systemd units")
        return
    ph = placeholders(env, role)
    installed = []
    for comp, p, name in units(env):
        text = render(p.read_text(), ph, str(p.relative_to(KIT_DIR)))
        ctx.write(UNIT_DIR / name, text)
        installed.append(name)
    enable = [u for u in installed if u in DEFAULT_ENABLE or u.endswith(".timer")]
    token = HOME / ".config" / "agent-mail" / "token.json"
    if "agent-mailroom.service" in enable and not token.exists():
        enable.remove("agent-mailroom.service")
        ctx.warn("no Gmail token yet (%s): agent-mailroom not enabled. Run agent-mail-auth, then re-run with --start"
                 % token)
    if not args.start:
        if installed:
            print("Units installed, not started. To start them:\n  systemctl --user daemon-reload && "
                  "systemctl --user enable --now %s" % " ".join(enable))
            print("  loginctl enable-linger $USER    # keep them running while you are logged out")
        return
    ctx.run(["systemctl", "--user", "daemon-reload"])
    if enable:
        r = ctx.run(["systemctl", "--user", "enable", "--now"] + enable)
        if r.returncode != 0:
            ctx.warn("systemctl enable failed: %s" % (r.stderr or "").strip()[-300:])
    lr = subprocess.run(["loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger"],
                        capture_output=True, text=True)
    if "Linger=yes" not in lr.stdout:
        ctx.warn("lingering is off: user services stop when you log out. Run: loginctl enable-linger $USER")


def step_cron(ctx, env, role, args):
    if not yes(env, "WITH_TODO_DISPATCH"):
        return
    if any(n.startswith("todo-dispatch") for _, _, n in units(env)):
        return                                          # the systemd timer does it
    line = "*/2 * * * * %s/todo-desk dispatch >> $HOME/.local/state/todo-desk/dispatch.log 2>&1  # %s" % (BIN_DIR, MARK)
    r = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    cur = r.stdout if r.returncode == 0 else ""
    if MARK in cur and "todo-desk dispatch" in cur:
        return
    if not args.start:
        print("To dispatch web/phone 'assign to agent' requests, add this crontab line (crontab -e), or re-run "
              "with --start:\n  " + line)
        return
    new = cur.rstrip("\n") + ("\n" if cur.strip() else "") + line + "\n"
    ctx.say("adding a crontab line for todo-desk dispatch")
    if not ctx.dry:
        (HOME / ".local" / "state" / "todo-desk").mkdir(parents=True, exist_ok=True)
        subprocess.run(["crontab", "-"], input=new, text=True, check=True)


STEP_FUNCS = {"config": step_config, "venv": step_venv, "wrappers": step_wrappers, "configs": step_configs,
              "instructions": step_instructions, "hooks": step_hooks, "orchestrator": step_orchestrator,
              "general-repo": step_general_repo, "systemd": step_systemd, "cron": step_cron}


def default_role():
    return "mac" if platform.system() == "Darwin" else "desktop"


def cmd_install(args):
    role = args.role or default_role()
    env_path = Path(expand(args.env))
    if not env_path.exists():
        if args.dry_run:
            raise SystemExit("%s does not exist. Run kit install once without --dry-run to create it." % env_path)
        env_path.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(str(KIT_DIR / "kit.example.env"), str(env_path))
        os.chmod(str(env_path), 0o600)
        print("Created %s from kit.example.env.\nEdit it (your name, your email, the agents' Gmail, GitHub "
              "names, paths), then run ./install.sh again." % env_path)
        return 0
    env = load_env(env_path, allow_example=args.allow_example)
    ctx = Ctx(args)
    steps = DESKTOP_STEPS if role == "desktop" else MAC_STEPS
    if args.only:
        only = [s.strip() for s in args.only.split(",") if s.strip()]
        bad = [s for s in only if s not in STEP_FUNCS]
        if bad:
            raise SystemExit("unknown step(s): %s (steps: %s)" % (", ".join(bad), " ".join(STEP_FUNCS)))
        steps = [s for s in steps if s in only]
    if args.skip:
        skip = {s.strip() for s in args.skip.split(",")}
        steps = [s for s in steps if s not in skip]
    for s in steps:
        print("\n== %s" % s)
        STEP_FUNCS[s](ctx, env, role, args)
    if args.labels and role == "desktop":
        print("\n== labels")
        cmd = ["bash", str(KIT_DIR / "todo" / "setup-labels.sh")] + (["--dry-run"] if args.dry_run else []) + \
            [env["TASKS_REPO"]]
        r = subprocess.run(cmd)
        if r.returncode != 0:
            ctx.warn("setup-labels.sh failed (exit %d)" % r.returncode)
    print("\nDone: %d file(s) %s, %d warning(s)." % (len(ctx.changes), "would change" if ctx.dry else "changed",
                                                     len(ctx.warnings)))
    for w in ctx.warnings:
        print("  - " + w)
    print("Next: kit doctor" + (" --online" if role == "desktop" else ""))
    return 0


# ---------------------------------------------------------------------------------------------- doctor

class Doc:
    def __init__(self):
        self.fails = 0
        self.warns = 0

    def ok(self, msg):
        print("  ok    " + msg)

    def bad(self, msg, fix=""):
        self.fails += 1
        print("  FAIL  " + msg + (("\n        fix: " + fix) if fix else ""))

    def meh(self, msg, fix=""):
        self.warns += 1
        print("  warn  " + msg + (("\n        fix: " + fix) if fix else ""))

    def check(self, cond, msg, fix="", warn_only=False):
        if cond:
            self.ok(msg)
        elif warn_only:
            self.meh(msg, fix)
        else:
            self.bad(msg, fix)
        return cond


def _out(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)


def cmd_doctor(args):
    role = args.role or default_role()
    d = Doc()
    print("agent-board-kit doctor (role %s, kit %s)" % (role, KIT_DIR))

    print("\n[kit.env]")
    env_path = Path(expand(args.env))
    if not d.check(env_path.exists(), "%s exists" % env_path, "./install.sh (creates it), then edit it"):
        return 1
    try:
        env = load_env(env_path, allow_example=args.allow_example)
        d.ok("values are filled in")
    except SystemExit as e:
        d.bad(str(e))
        return 1

    print("\n[programs]")
    d.check(sys.version_info >= (3, 9), "python %s >= 3.9" % platform.python_version())
    for prog, why, need in (("git", "worktrees", True), ("tmux", "agent sessions", True),
                            ("gh", "GitHub (new repos, PRs, the to-do list)", True),
                            ("claude", "Claude Code", True), ("codex", "Codex (optional)", False)):
        d.check(bool(shutil.which(prog)), "%s on PATH (%s)" % (prog, why), "install %s" % prog, warn_only=not need)
    d.check(str(BIN_DIR) in os.environ.get("PATH", "").split(os.pathsep), "%s on PATH" % BIN_DIR,
            'add export PATH="$HOME/.local/bin:$PATH" to ~/.profile')
    code, out = _out(["git", "config", "--global", "user.email"])
    d.check(bool(out.strip()), "git has an identity (agents commit as you)",
            'git config --global user.name "Your Name"; git config --global user.email you@example.com',
            warn_only=True)
    if shutil.which("gh"):
        code, out = _out(["gh", "auth", "status"])
        d.check(code == 0, "gh is logged in", "gh auth login")
    if shutil.which("codex"):
        code, out = _out(["codex", "--version"])
        m = re.search(r"(\d+)\.(\d+)\.(\d+)", out)
        if m:
            d.check((int(m.group(1)), int(m.group(2))) >= (0, 149), "codex %s >= 0.149 (codex queue)" % m.group(0),
                    "upgrade codex", warn_only=True)

    print("\n[tools]")
    for name, script in tools(env, role):
        p = BIN_DIR / name
        d.check(_is_wrapper(p), "%s wrapper" % name, "./install.sh --only wrappers")
    vpy = VENV / "bin" / "python"
    if d.check(vpy.exists(), "venv %s" % VENV, "./install.sh --only venv"):
        code, out = _out([str(vpy), "-c", "import googleapiclient, google.oauth2.credentials"])
        d.check(code == 0, "Google client libraries import in the venv", "./install.sh --only venv")

    print("\n[configs]")
    mpath = HOME / ".config" / "agent-mail" / "config.json"
    try:
        m = _load_json(mpath)
    except SystemExit as e:
        m = {}
        d.bad(str(e))
    if d.check(bool(m), "%s exists" % mpath, "./install.sh --only configs"):
        d.check(m.get("account") == env["AGENT_EMAIL"].lower(), "mailroom account = AGENT_EMAIL")
        d.check(env["OWNER_EMAIL"].lower() in (m.get("allowlist") or []), "OWNER_EMAIL is on the allowlist")
        if role == "mac":
            d.check(m.get("mail_proxy") == env["HOST_ID"] and (m.get("remote_hosts") or {}).get(env["HOST_ID"])
                    == env["DESKTOP_HOST"] and m.get("send_enabled") is False,
                    "mac proxies mail through %s (ssh %s)" % (env["HOST_ID"], env["DESKTOP_HOST"]),
                    "./install.sh --role mac --only configs")
    if role == "desktop":
        t = HOME / ".config" / "todo-desk" / "config.json"
        d.check(t.exists() and _load_json(t).get("repo") == env["TASKS_REPO"], "todo-desk config names %s"
                % env["TASKS_REPO"], "./install.sh --only configs")

    print("\n[gmail]" if role == "desktop" else "\n[mail proxy]")
    if role == "desktop":
        cred = HOME / ".config" / "agent-mail" / "credentials.json"
        tok = HOME / ".config" / "agent-mail" / "token.json"
        d.check(cred.exists(), "OAuth client file %s" % cred, "docs/02-agent-gmail.md, step 3", warn_only=tok.exists())
        if d.check(tok.exists(), "Gmail token %s" % tok, "agent-mail-auth   (docs/02-agent-gmail.md, step 4)"):
            mode = tok.stat().st_mode & 0o777
            d.check(mode & 0o077 == 0, "token is private (mode %o)" % mode, "chmod 600 %s" % tok)
            if args.online:
                code, out = _out([str(VENV / "bin" / "python"), "-c",
                                  "import sys; sys.path.insert(0, %r)\n"
                                  "from agentmail import gmail\n"
                                  "print(gmail.profile(gmail.service()).get('emailAddress',''))"
                                  % str(KIT_DIR / "mailroom")], timeout=40)
                who = out.strip().splitlines()[-1] if out.strip() else ""
                d.check(code == 0 and who.lower() == env["AGENT_EMAIL"].lower(),
                        "token works and belongs to %s (got %r)" % (env["AGENT_EMAIL"], who[:80]),
                        "agent-mail-auth   (re-consent; see Troubleshooting for 'invalid_grant')")
    else:
        code, out = _out(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", env["DESKTOP_HOST"], "true"])
        d.check(code == 0, "ssh %s works without a prompt" % env["DESKTOP_HOST"],
                "set up the alias and key in ~/.ssh/config (docs/07-mac.md)")

    print("\n[Claude Code / Codex]")
    sp = HOME / ".claude" / "settings.json"
    s = _load_json(sp) if sp.exists() else {}
    d.check(s.get("crossSessionInbound") == "accept", 'settings.json "crossSessionInbound": "accept"',
            "./install.sh --only hooks")
    cmds = {h.get("command", "") for g in (s.get("hooks") or {}).get("Stop", []) for h in g.get("hooks", [])}
    d.check(any("agent-status hook --cli claude" in c for c in cmds), "Claude Stop hook runs agent-status",
            "./install.sh --only hooks")
    cm = HOME / ".claude" / "CLAUDE.md"
    d.check(cm.exists() and CLAUDE_INCLUDE in cm.read_text(), "~/.claude/CLAUDE.md includes the agent instructions",
            "./install.sh --only instructions")
    d.check(INSTRUCTIONS.exists(), "%s rendered" % INSTRUCTIONS, "./install.sh --only instructions")
    if shutil.which("codex"):
        ch = HOME / ".codex" / "hooks.json"
        d.check(ch.exists() and "agent-status hook --cli codex" in ch.read_text(), "Codex hooks run agent-status",
                "./install.sh --only hooks", warn_only=True)
        ca = HOME / ".codex" / "AGENTS.md"
        d.check(ca.exists() and BLOCK_BEGIN in ca.read_text(), "~/.codex/AGENTS.md has the agent instructions",
                "./install.sh --only instructions", warn_only=True)

    if role == "desktop":
        print("\n[orchestrator]")
        od = env["ORCHESTRATOR_DIR_PATH"]
        d.check((od / "AGENTS.md").exists() and (od / ".git").exists(), "%s is a git repo with AGENTS.md" % od,
                "./install.sh --only orchestrator")
        print("\n[services]")
        if platform.system() == "Linux" and shutil.which("systemctl"):
            for comp, p, name in units(env):
                inst = (UNIT_DIR / name).exists()
                if not d.check(inst, "%s installed" % name, "./install.sh --only systemd", warn_only=True):
                    continue
                if name.endswith(".service") and name not in DEFAULT_ENABLE:
                    continue                            # started by its timer or by hand
                if name == "agent-restart-restore.service":
                    code, out = _out(["systemctl", "--user", "is-enabled", name])
                    d.check(out.strip() == "enabled", "%s enabled (runs once after boot)" % name,
                            "systemctl --user enable %s" % name, warn_only=True)
                    continue
                code, out = _out(["systemctl", "--user", "is-active", name])
                d.check(out.strip() == "active", "%s active" % name,
                        "systemctl --user enable --now %s; journalctl --user -u %s" % (name, name),
                        warn_only=name != "agent-mailroom.service")
            code, out = _out(["loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger"])
            d.check("Linger=yes" in out, "lingering on (services survive logout)", "loginctl enable-linger $USER",
                    warn_only=True)
        if args.online and shutil.which("gh"):
            print("\n[to-do repo]")
            code, out = _out(["gh", "label", "list", "--repo", env["TASKS_REPO"], "--limit", "200", "--json", "name",
                              "--jq", ".[].name"])
            if d.check(code == 0, "gh can read %s" % env["TASKS_REPO"],
                       "gh repo create %s --private" % env["TASKS_REPO"]):
                names = set(out.split())
                need = {"source:claude", "list:tasks", "status:agent-assigned", "status:claude-processed"}
                d.check(need <= names, "labels exist (%s)" % ", ".join(sorted(need)),
                        "./install.sh --labels   (runs todo/setup-labels.sh)")

    print("\n%d failure(s), %d warning(s)." % (d.fails, d.warns))
    return 1 if d.fails else 0


# ---------------------------------------------------------------------------------------------- misc

def cmd_render(args):
    role = args.role or default_role()
    env = load_env(Path(expand(args.env)), allow_example=args.allow_example)
    p = Path(args.template)
    if not p.is_absolute():
        p = KIT_DIR / p
    sys.stdout.write(render(p.read_text(), placeholders(env, role), str(p)))
    return 0


def cmd_uninstall(args):
    ctx = Ctx(args)
    for p in sorted(BIN_DIR.glob("*")) if BIN_DIR.exists() else []:
        if _is_wrapper(p):
            ctx.say("remove %s" % p)
            if not ctx.dry:
                p.unlink()
    kit_units = {q.name[:-3] if q.name.endswith(".in") else q.name
                 for q in KIT_DIR.glob("*/systemd/*") if q.suffix in (".in", ".service", ".timer")}
    for p in sorted(UNIT_DIR.glob("*")) if UNIT_DIR.exists() else []:
        try:
            txt = p.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        if str(KIT_DIR) in txt or (p.name in kit_units and p.suffix == ".timer"):
            ctx.say("disable and remove %s" % p.name)
            if not ctx.dry:
                subprocess.run(["systemctl", "--user", "disable", "--now", p.name], capture_output=True)
                p.unlink()
    codex_md = HOME / ".codex" / "AGENTS.md"
    if codex_md.exists() and BLOCK_BEGIN in codex_md.read_text():
        cur = codex_md.read_text()
        pre, rest = cur.split(BLOCK_BEGIN, 1)
        ctx.write(codex_md, (pre.rstrip("\n") + "\n" + rest.split(BLOCK_END, 1)[1].lstrip("\n")).lstrip("\n"))
    cm = HOME / ".claude" / "CLAUDE.md"
    if cm.exists() and CLAUDE_INCLUDE in cm.read_text():
        lines = [l for l in cm.read_text().splitlines()
                 if l.strip() != CLAUDE_INCLUDE and "(agent-board-kit)" not in l]
        ctx.write(cm, "\n".join(lines).rstrip("\n") + "\n")
    print("Left in place: your configs (~/.config/agent-mail, agent-kit, todo-desk, agent-board), the Gmail token, "
          "the hooks in ~/.claude/settings.json and ~/.codex/hooks.json (remove the agent-status entries by hand), "
          "the orchestrator dir, state in ~/.local/state, the venv (%s) and any crontab line." % VENV)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="kit", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(p):
        p.add_argument("--env", default=str(DEFAULT_ENV), help="kit.env (default %(default)s)")
        p.add_argument("--role", choices=["desktop", "mac"], help="default: mac on macOS, desktop otherwise")
        p.add_argument("--allow-example", action="store_true", help=argparse.SUPPRESS)

    p = sub.add_parser("install", help="install or update (idempotent)")
    common(p)
    p.add_argument("--dry-run", action="store_true", help="show what would change, change nothing")
    p.add_argument("--only", help="comma-separated steps: " + ",".join(STEP_FUNCS))
    p.add_argument("--skip", help="comma-separated steps to skip")
    p.add_argument("--start", action="store_true", help="also enable/start the services and timers (or the dispatch cron line where there is no timer)")
    p.add_argument("--labels", action="store_true", help="also create the to-do labels in TASKS_REPO (writes to GitHub)")
    p.add_argument("--force", action="store_true", help="replace files the kit did not create (backups are kept)")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("doctor", help="check the installation")
    common(p)
    p.add_argument("--online", action="store_true", help="also check the Gmail token and the GitHub repo over the network")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("render", help="print a template rendered with your values")
    common(p)
    p.add_argument("template")
    p.set_defaults(func=cmd_render)

    p = sub.add_parser("uninstall", help="remove wrappers, units and instruction blocks")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_uninstall)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
