# agent-board-kit: everything personal lives in this one file.
#
# Copy it to ~/.config/agent-kit/kit.env (./install.sh does this for you on the first run),
# fill it in, then run ./install.sh again. The installer turns it into each component's own
# config file and renders the templates (agent instructions, orchestrator brief, systemd units).
# Shell syntax: KEY="value". "~" is expanded. Nothing secret goes here: tokens live in their own
# files with mode 600 (see docs/02-agent-gmail.md).

# --- Who you are -------------------------------------------------------------------------------
# Your first name. Agents and the orchestrator see it in every message ("[email from Alex ...]").
OWNER_NAME="Alex"
# Your own email address. It is the ONLY sender whose mail is delivered to agents as an
# instruction, and the address agents send results to.
OWNER_EMAIL="alex@example.com"

# --- The agents' mailbox -----------------------------------------------------------------------
# A Gmail account created just for your agents (docs/02-agent-gmail.md). Never your own.
AGENT_EMAIL="yourname.agents@gmail.com"
# Display name on agent mail; the session name is appended: "Agents (fix-login-bug)".
AGENT_FROM_NAME="Agents"

# --- GitHub ------------------------------------------------------------------------------------
# User or organisation that owns new repos made by `agent-spawn --new-repo`.
GITHUB_OWNER="alex-gh"
# The private repo whose issues are your to-do list (docs/06-todo.md).
TASKS_REPO="alex-gh/tasks"

# --- Where things live on the always-on Linux machine ------------------------------------------
# Your repos and the agents' git worktrees (worktrees go next to their repo).
REPOS_ROOT="~/code"
# A repo for tasks that belong to no project (notes, research, errands). Created if missing.
GENERAL_REPO="~/code/general"
# The orchestrator's working directory (a small local git repo the installer creates).
ORCHESTRATOR_DIR="~/code/orchestrator"

# --- Machines ----------------------------------------------------------------------------------
# The Linux machine's name in mail routing (a label, not a hostname). Keep "desktop" unless you
# have a reason. Use the same kit.env on the Mac: there it names the machine mail is proxied to.
HOST_ID="desktop"
# The ssh alias the Mac uses to reach the Linux machine (in the Mac's ~/.ssh/config).
DESKTOP_HOST="desktop"
# The ssh alias the Linux machine uses to reach the Mac. Leave empty if there is no Mac
# or the Linux machine cannot ssh to it (then Mac sessions' replies are held, not delivered).
MAC_HOST=""

# --- Optional components (yes/no) --------------------------------------------------------------
# agent-memwatch: warn the biggest agents at 80% RAM, email you at 90% (Linux, systemd user manager).
# Per-agent memory caps apply either way (agent_memory_max in ~/.config/agent-mail/config.json; "off" disables).
WITH_MEMWATCH="yes"
# agent-restart: restart/update the machine from the board and resume every agent after boot.
WITH_RESTART="yes"
# cloud-watchdog: watch paid cloud resources agents launch (needs provider accounts; see its README).
WITH_CLOUD_WATCHDOG="no"
# Turn web/phone "assign to agent" requests into agents every 2 minutes (todo-desk dispatch).
WITH_TODO_DISPATCH="yes"
