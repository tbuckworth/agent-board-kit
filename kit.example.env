# agent-board-kit: everything personal lives in this one file.
#
# Copy it to ~/.config/agent-kit/kit.env (./install.sh does this for you on the first run),
# fill it in, then run ./install.sh again. The installer turns it into each component's own
# config file and renders the templates (agent instructions, orchestrator brief, systemd units).
# Shell syntax: KEY="value". "~" is expanded. Nothing secret goes here: tokens live in their own
# files with mode 600 (see docs/02-agent-gmail.md).

# --- Who you are -------------------------------------------------------------------------------
# Your first name. Agents and the orchestrator see it in every message ("[email from Alex ...]").
OWNER_NAME="Alex"
# Your identity: an email address of yours. No mail is sent to it unless you turn Gmail on below.
# Use the address you log in to Tailscale with: the phone app only answers requests from that login.
# With Gmail on, it is also the ONLY sender whose mail is taken as an instruction, and where agents send results.
OWNER_EMAIL="alex@example.com"

# --- Agent mail --------------------------------------------------------------------------------
# Display name on agent mail; the session name is appended: "Agents (fix-login-bug)".
AGENT_FROM_NAME="Agents"
# Gmail is optional. "no" (the default): agent mail and every alert stay on your machines, in the board's
# Mail tab and the phone app; nothing goes through Gmail, and you need no Google account or project.
# "yes": agents can also mail you and others through a Gmail account made just for them, and you can
# instruct them by email (docs/02-agent-gmail.md). Then set AGENT_EMAIL to that account (never your own).
WITH_GMAIL="no"
AGENT_EMAIL=""

# --- Phone app ---------------------------------------------------------------------------------
# The Agent Mail phone app: your agent mail, replies and the orchestrator on your phone, over your
# Tailscale network, signed in with a passkey (board/README.md, "Mail on the phone"). Needs Tailscale.
WITH_PHONE_APP="yes"

# --- Researcher ----------------------------------------------------------------------------------
# The Mail tab's Researcher switch hands a thread's agent to the public "researcher" Claude Code plugin
# (a structured research workflow). "yes": the installer installs the plugin into Claude Code
# (mailroom/README.md, "Researcher mode").
WITH_RESEARCHER="yes"

# --- Voice, the desk and the desktop (all optional) -------------------------------------------------------------
# The desk: one always-running Claude you talk to (through the ask box and the voice page), which can read your
# repos and send your agents messages when you ask it to (board/README.md, "The desk").
WITH_DESK="no"
# Spoken answers for the Mac's ask box (⌃⌥A): Kokoro, a local voice model, in a venv of its own (about 2 GB with
# PyTorch). Without it, the ask box still works in text and the Mac speaks with its own voice.
WITH_SPEECH="no"
# The voice page: a Gemini Live front desk on your phone, with read-only tools over your agents. Needs the phone app
# and your own Gemini API key in ~/.config/agent-board/gemini-key (mode 600) (board/README.md, "Voice page").
WITH_VOICE_PAGE="no"
# Unlock the Linux machine's keyring from the Mac or the phone after a restart, for a desktop that logs in by itself
# (needs: sudo apt install python3-gi python3-cryptography) (board/README.md, "Unlock the desktop").
WITH_KEYRING_UNLOCK="no"
# Keep every Claude Code and Codex transcript, catalogued by board group, in TRANSCRIPTS_DIR (an existing folder,
# ideally on another disk), copied once a day (board/README.md, "Transcript archive").
WITH_TRANSCRIPTS="no"
TRANSCRIPTS_DIR=""

# --- GitHub ------------------------------------------------------------------------------------
# User or organisation that owns new repos made by `agent-spawn --new-repo`.
GITHUB_OWNER="alex-gh"
# The private repo whose issues are your to-do list (docs/06-todo.md).
TASKS_REPO="alex-gh/tasks"

# --- Where things live on the always-on Linux machine ------------------------------------------
# Your repos and the agents' git worktrees (worktrees go next to their repo).
REPOS_ROOT="~/code"
# A repo for tasks that belong to no project (notes, research, errands). Created if missing.
GENERAL_REPO="~/code/general"
# The orchestrator's working directory (a small local git repo the installer creates).
ORCHESTRATOR_DIR="~/code/orchestrator"

# --- Machines ----------------------------------------------------------------------------------
# The Linux machine's name in mail routing (a label, not a hostname). Keep "desktop" unless you
# have a reason. Use the same kit.env on the Mac: there it names the machine mail is proxied to.
HOST_ID="desktop"
# The ssh alias the Mac uses to reach the Linux machine (in the Mac's ~/.ssh/config).
DESKTOP_HOST="desktop"
# The ssh alias the Linux machine uses to reach the Mac. Leave empty if there is no Mac
# or the Linux machine cannot ssh to it (then Mac sessions' replies are held, not delivered).
MAC_HOST=""

# --- Optional components (yes/no) --------------------------------------------------------------
# agent-memwatch: warn the biggest agents at 80% RAM, email you at 90% (Linux, systemd user manager).
# Per-agent memory caps apply either way (agent_memory_max in ~/.config/agent-mail/config.json; "off" disables).
WITH_MEMWATCH="yes"
# agent-restart: restart/update the machine from the board and resume every agent after boot.
WITH_RESTART="yes"
# cloud-watchdog: watch paid cloud resources agents launch (needs provider accounts; see its README).
WITH_CLOUD_WATCHDOG="no"
# Turn web/phone "assign to agent" requests into agents every 2 minutes (todo-desk dispatch).
WITH_TODO_DISPATCH="yes"
# Update Claude Code and Codex every 6 hours (board/bin/agent-cli-update), so agents launched or resumed
# by the kit never stop at an "update available" prompt and match the versions the kit is tested with.
WITH_CLI_UPDATE="yes"
# Recompute the board's Time page every 15 minutes (board/bin/agent-board time). Off: it is computed when
# you open it, which takes a little longer. It may call a model (sonnet, through your Claude login) to guess
# groups for what you have not grouped; "guess_model": null in ~/.config/agent-board/time.json stops that.
# See board/README.md, "Time page".
WITH_TIME_PAGE="no"

# --- Mail backup (optional) ---------------------------------------------------------------------
# The mailroom keeps every mail your agents send you (the board's Mail tab reads it). List directories on
# another disk, separated by spaces, to copy that store and the mailroom database there every hour
# (agent-mail backup, agent-mail-backup.timer). Each directory is created if missing, but not the folder
# above it. Empty: no backup timer.
MAIL_BACKUP_DIRS=""
