#!/usr/bin/env python3
"""agent-mail: send email from the agents account so that replies route back to you.

    agent-mail send --to ADDR [--cc ADDR] --subject S [--unrouted] MAIL-OPTIONS
      ADDR: an address, or owner (or config owner_name) for the owner's address
    agent-mail reply INBOUND_ID [--subject S] MAIL-OPTIONS
      without --subject, in that mail's thread; with it, as a new thread under S that links back, for a thread
      whose subject no longer fits
      MAIL-OPTIONS: [--body-file F] [--html F] [--image NAME=PATH ...] [--attach PATH ...] [--no-review WHY]
                    [--session NAME_OR_ID] [--cli claude|codex] [--request-id UUID]
      the text: --body-file, else what is piped in, else made from --html
    agent-mail guide                           # how to write mail to the owner; read it before a results mail
    agent-mail withdraw [--session NAME_OR_ID] [--cli claude|codex]   # drop your mail the pre-send review sent back
    agent-mail sent [--limit N]
    agent-mail inbox [--held] [--limit N]
    agent-mail show INBOUND_ID
    agent-mail release INBOUND_ID TARGET [--cli claude|codex] [--host HOST]   # deliver a held mail to a session
    agent-mail rerun INBOUND_ID                # run the orchestrator again on a held or failed mail
    agent-mail receipt REQUEST_ID              # the outcome of a proxied send, without sending again
    agent-mail recover INBOUND_ID [--query TEXT ...] [--refresh]   # read-only search for an unowned reply's session
    agent-mail status
    agent-mail mailbox list|show|mark|sync|answer|part|summary|backfill ...   # the owner's mailbox, for the Mail tab
    agent-mail backup                          # copy the message store and the database to config backup.targets

Mail without --unrouted, to anyone, passes the pre-send review first (config "review"); one it sends back prints
NOT SENT and exits 3.
Details: README.md, sections "Sending mail from a session", "The mailroom", "Mac requests and replies" and "The
Mail tab's mailbox".
"""
import argparse
import functools
import json
import os
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import (backup, cli, config, gmail, groupmail, listing, mailbox, mailroom, outbound,  # noqa: E402
                       piped, registry, remote, review, routing, rpc, widgets)
from agentmail.outbound import MailError, session_label  # noqa: E402
from agentmail.config import ConfigError  # noqa: E402
from agentmail.gmail import NoToken  # noqa: E402

die = functools.partial(cli.die, "agent-mail")


def read_body(path, html_body):
    """The plain text: --body-file, else what was piped or redirected in, else made from the HTML. Never waits
    on an input that was not piped in (agentmail/piped.py says why)."""
    if path:
        return Path(path).read_text()
    try:
        text = piped.piped_text()
    except TimeoutError as e:
        die("no body: %s; pass --body-file FILE" % e)
    if text is None and not html_body:
        die("no body: pass --body-file FILE, or pipe the text in")
    return outbound.plain_text(text, html_body)


def orchestrator_pseudo(cfg):
    return {"cli": "orchestrator", "id": "orchestrator", "name": registry.orchestrator_name(),
            "cwd": os.path.expanduser(cfg["orchestrator_dir"]), "live": True}


def resolve_session(cfg, spec, cli_hint):
    """The session spec names (registry.resolve_exact; die when it names none or several), or the orchestrator by its
    name while no live session has that name. Without spec: the orchestrator under AGENT_ORCHESTRATOR=1, else this
    Claude session (CLAUDE_CODE_SESSION_ID)."""
    if spec is None:
        if os.environ.get("AGENT_ORCHESTRATOR") == "1":
            return orchestrator_pseudo(cfg)
        sess = registry.session_from_env(os.getcwd())
        if sess is None:
            die("not inside a Claude session and no --session given. Codex: pass --session "
                "<name from /rename or thread uuid>; see `agent-send --list`.")
        return sess
    found = registry.resolve_exact(spec, cli_hint)
    if spec.lower() == registry.orchestrator_name().lower() and not any(s["live"] and s["name"] == spec
                                                                        for s in found[2]):
        return orchestrator_pseudo(cfg)
    return cli.chosen_session("agent-mail", spec, found)


def relabel(ctx, inbound_id):
    """Make the mail's Gmail labels show its saved state (mailroom.label). The saved state is what counts and the
    labels only mirror it, so a Gmail failure here is a warning."""
    row = ctx.st.inbound(inbound_id)
    try:
        mailroom.label(ctx.svc, ctx.cfg, row["gmail_id"], row["action"])
    except Exception as e:
        print("warning: could not relabel: %s" % e, file=sys.stderr)


def outgoing(a):
    """The mail a send or reply carries, from its flags: --html, the text (read_body), --image and --attach, its
    widget blocks checked and turned into what Gmail is sent (widgets.prepare)."""
    html_body = Path(a.html).read_text() if a.html else None
    text = read_body(a.body_file, html_body)
    mail = outbound.Mail(text, html_body, outbound.load_images(a.image), outbound.load_files(a.attach))
    outbound.check_size(mail)
    return widgets.prepare(mail)


def check_send_enabled(cfg):
    if not cfg["send_enabled"]:
        die("sending is disabled on this machine (config send_enabled=false): the mailroom runs on the "
            "desktop and cannot route replies to sessions here. Send from a desktop session, or use "
            "%s's personal Gmail tools if the mail is to be sent as %s." % (cfg["owner_name"], cfg["owner_name"]))
    if not cfg.get("mail_proxy"):
        try:
            config.require_account(cfg)
        except config.ConfigError as e:
            die(str(e))


def report(outcome):
    """Print what a send or reply did; the exit code is 3 when the pre-send review held the mail."""
    print(outcome.text(), end="")
    return 3 if outcome.held else 0


def do_send(ctx, a):
    check_send_enabled(ctx.cfg)
    if a.unrouted and os.environ.get("SSH_CONNECTION"):
        die("unrouted SSH sends lose the originating session. Run agent-mail locally on the Mac "
            "with --session so the supported proxy preserves ownership.")
    mail = outgoing(a)
    if a.unrouted:
        to = outbound.recipient(ctx.cfg, a.to)
        res, _ = outbound.transmit(ctx, None, to, outbound.recipient(ctx.cfg, a.cc), a.subject, mail, None)
        print("sent to %s | subject %r | thread %s | unrouted (replies go to the orchestrator)"
              % (to, a.subject, res["threadId"]))
        return 0
    row = outbound.sender_row(ctx, resolve_session(ctx.cfg, a.session, a.cli))
    return report(outbound.send_mail(ctx, row, a.to, a.cc, a.subject, mail, a.no_review))


def do_reply(ctx, a):
    check_send_enabled(ctx.cfg)
    inb, row = outbound.reply_target(ctx.st, a.inbound_id)
    if row is None:
        row = outbound.sender_row(ctx, resolve_session(ctx.cfg, a.session, a.cli))
    return report(outbound.reply_mail(ctx, row, inb, outgoing(a), a.no_review, a.subject))


def do_guide(ctx, a):
    print(review.read_prompt(review.RULES_PATH, ctx.cfg), end="")
    return 0


def do_withdraw(ctx, a):
    """Drop this session's mail that the review sent back, so the mailroom does not send it later."""
    print(outbound.withdraw(ctx.st, outbound.sender_row(ctx, resolve_session(ctx.cfg, a.session, a.cli))["tag"]), end="")
    return 0


def do_flush_drafts(ctx, a):
    outbound.flush_drafts(ctx)
    return 0


def do_sent(ctx, a):
    print(listing.sent(ctx.st, a.limit, ctx.cfg["host_id"]), end="")
    return 0


def do_inbox(ctx, a):
    print(listing.inbox(ctx.st, a.held, a.limit), end="")
    return 0


def do_show(ctx, a):
    print(listing.show(ctx.st, a.inbound_id), end="")
    return 0


def do_receipt(ctx, a):
    print(listing.receipt(ctx.st, a.request_id, ctx.cfg["host_id"]), end="")
    return 0


def do_release(ctx, a):
    cfg, st = ctx.cfg, ctx.st
    inb = st.inbound(a.inbound_id)
    if not inb:
        die("no inbound mail with id %s" % a.inbound_id, 4)
    if a.target == "origin":
        row = st.session_by_tag(inb["matched_tag"]) if inb["matched_tag"] else None
        if row is None:
            die("no recorded origin; recover ownership before releasing")
        if row["cli"] == routing.GROUP_CLI:
            die("mail #%d answers the mail of group %r, which no session owns: post its text with %s"
                % (inb["id"], row["session_name"], groupmail.post_command(cfg, row["session_id"])))
        sess = {"cli": row["cli"], "id": row["session_id"], "name": row["session_name"]}
    elif getattr(a, "host", None) and a.host != cfg["host_id"]:
        if a.cli not in config.CLIS:
            die("remote handoff requires --cli and a full session UUID")
        try:
            sid = str(uuid.UUID(a.target))
            sess = remote.call(cfg, a.host, {"op": "lookup", "cli": a.cli, "session_id": sid})
        except (ValueError, remote.RemoteError) as e:
            die(str(e))
        row = st.session_for(sess["cli"], sess["id"], sess["name"], sess["cwd"], origin_host=a.host)
    else:
        sess = resolve_session(cfg, a.target, a.cli)
        row = outbound.sender_row(ctx, sess)
    if sess["cli"] == "orchestrator":
        return do_rerun(ctx, a)
    tier = routing.sender_tier(inb["from_addr"], cfg)
    if tier is None or (inb["detail"] or "").startswith("DKIM check failed"):
        die("cannot release mail from an unverified sender")
    collab = cfg["collaborators"][inb["from_addr"]] if tier == "collaborator" else {}
    try:
        delivered, _files = mailroom.delivered_body(cfg, inb, row["origin_host"])
    except mailroom.FILES_NOT_PLACED as e:
        die("delivery failed: the files were not put on %s: %s" % (row["origin_host"], e))
    text = routing.event_text("session", tier, inb["id"], inb["from_name"], inb["from_addr"], collab, inb["subject"],
                              delivered, "", cfg["owner_name"],
                              reminder=mailroom.owner_reminder(st, cfg, tier, inb["id"], inb["body"] or ""))
    rc, out = mailroom.deliver_to_session(None, st, cfg, inb["id"], inb["gmail_id"], row, text, "released by hand", False,
                                          matched_tag=row["tag"], match_rule="manual",
                                          released_to=session_label(sess, cfg["host_id"]), released_at=int(time.time()))
    if rc != 0:
        die("delivery failed (%d): %s" % (rc, out), rc)
    relabel(ctx, inb["id"])
    print("released %d to %s: %s" % (inb["id"], session_label(sess, cfg["host_id"]), out))
    return 0


def do_proxy(ctx, a):
    """Run a proxyable command (rpc.PROXY_ACTIONS) on the central mailroom: the session it runs for and the mail it
    sends are resolved and read here, on the machine it was typed on."""
    origin = mail = request_id = None
    if a.cmd in ("send", "reply") and getattr(a, "unrouted", False):
        die("proxy mail requires an origin session; --unrouted is not supported")
    if a.cmd in ("send", "reply", "withdraw"):
        origin = resolve_session(ctx.cfg, a.session, a.cli)
    if a.cmd in ("send", "reply"):
        mail = outgoing(a)
        request_id = a.request_id or str(uuid.uuid4())
        print("proxy request %s (receipt: agent-mail receipt %s)" % (request_id, request_id), file=sys.stderr)
    try:
        result, held = rpc.proxy(ctx.cfg, a.cmd, rpc.flags(a.cmd, a), origin, mail, request_id)
    except remote.RemoteError as e:
        die(str(e))
    print(result, end="" if result.endswith("\n") else "\n")
    return 3 if held else 0


def do_rpc(ctx, a):
    print(rpc.serve(ctx, sys.stdin.read(remote.MAX_REQUEST + 1)))
    return 0


def do_recover(ctx, a):
    from agentmail import recovery
    cfg, st = ctx.cfg, ctx.st
    inb = st.inbound(a.inbound_id)
    if inb is None:
        die("unknown inbound mail")
    result = recovery.recover(st, cfg, inb, queries=a.query, refresh=a.refresh)
    relabel(ctx, inb["id"])
    recovery.notify(ctx.svc, st, cfg, st.inbound(a.inbound_id))
    print(json.dumps(result, indent=2))
    return 0


def do_search_local(ctx, a):
    from agentmail import recovery
    print(json.dumps(recovery.search(json.loads(sys.stdin.read(remote.MAX_REQUEST)), ctx.cfg)))
    return 0


def do_rerun(ctx, a):
    cfg, st = ctx.cfg, ctx.st
    inb = st.inbound(a.inbound_id)
    if not inb:
        die("no inbound mail with id %s" % a.inbound_id, 4)
    from agentmail import orchestrate
    svc = ctx.svc
    # A sender on neither list is framed as a collaborator's agent: input under the guard, never the owner's word.
    tier = routing.sender_tier(inb["from_addr"], cfg) or "collaborator"
    collab = cfg["collaborators"].get(inb["from_addr"], {})
    thread_txt = ""
    if inb["thread_id"]:   # the orchestrator is told it gets the thread: a failed fetch stops the rerun
        thread_txt = routing.thread_context(mailroom.thread_messages(svc, st, inb), cfg["account"], cfg["collaborators"])
    delivered, _files = mailroom.delivered_body(cfg, inb, cfg["host_id"])
    text = routing.event_text("orchestrator", tier, inb["id"], inb["from_name"], inb["from_addr"], collab, inb["subject"],
                              delivered, thread_txt, cfg["owner_name"])
    info = orchestrate.run_event(text, "rerun", cfg)
    outcome, _detail = mailroom.settle_run(svc, st, cfg, inb["id"], inb["gmail_id"], info, "rerun", False, False)
    if outcome == "retained":
        print("explicit handoff retained")
        return 0
    if outcome in ("delivered", "failed"):
        relabel(ctx, inb["id"])
    print(("ok" if info["ok"] else "FAILED") + " · $%s · %s turns\n%s" % (info["cost"], info["turns"], info["result"] if info["ok"] else info["error"]))
    return 0 if info["ok"] else 1


def do_status(ctx, a):
    import fcntl
    cfg, st = ctx.cfg, ctx.st
    print("account       %s" % cfg["account"])
    print("allowlist     %s" % ", ".join(cfg["allowlist"]))
    print("db            %s" % config.DB_PATH)
    running = False
    try:
        fh = open(config.LOCK_PATH, "a+")
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(fh, fcntl.LOCK_UN)
        except OSError:
            running = True
        fh.close()
    except OSError:
        pass
    print("daemon        %s" % ("running (lock held)" if running else "not running"))
    print("history_id    %s" % st.get_meta("history_id", "-"))
    print("last_poll     %s" % listing.timestamp(st.get_meta("last_poll")))
    print("counts        %s" % json.dumps(st.counts()))
    print("orchestrator  model=%s effort=%s dir=%s" % (cfg.get("orchestrator_model"), cfg.get("orchestrator_effort"),
                                                      cfg.get("orchestrator_dir")))
    from agentmail import orchestrate
    runs = orchestrate.logged_runs()
    cost = sum(r["cost"] for r in runs if isinstance(r.get("cost"), (int, float)))
    print("orch. runs    %d, $%.2f total, last: %s" % (len(runs), cost, ("ok" if runs[-1]["ok"] else "FAILED") if runs else "-"))
    print("collaborators %s" % (", ".join("%s (%s)" % (k, v.get("name", "?")) for k, v in cfg["collaborators"].items()) or "none"))
    for target in cfg["backup"]["targets"]:
        print("backup        %s, last copied %s" % (target, listing.timestamp(st.get_meta(backup.META % target))))
    print("require_dkim  %s" % cfg.get("require_dkim"))
    try:
        p = gmail.profile(ctx.svc)
        print("mailbox       %s, %s messages, historyId %s" % (p["emailAddress"], p["messagesTotal"], p["historyId"]))
    except Exception as e:
        print("mailbox       ERROR %s" % e)
    return 0


def owner_only(ctx, what):
    """Stop unless the command runs outside an agent session: what acts as the owner (cli.refuse_in_agent)."""
    cli.refuse_in_agent("agent-mail", what, ctx.cfg["owner_name"])


def emit(result):
    """Print a mailbox command's answer as one JSON object."""
    print(json.dumps(result))
    return 0


def do_mailbox_list(ctx, a):
    return emit(mailbox.list_threads(ctx.st, ctx.cfg, a.box, a.query, a.limit, time.time()))


def do_mailbox_show(ctx, a):
    return emit(mailbox.show(ctx.st, ctx.cfg, a.thread, time.time()))


def do_mailbox_mark(ctx, a):
    owner_only(ctx, "mailbox mark")
    return emit(mailbox.mark(ctx.st, ctx.cfg, a.threads, a.op, a.upto, a.until, time.time()))


def do_mailbox_sync(ctx, a):
    owner_only(ctx, "mailbox sync")
    try:
        text = piped.piped_text()
    except TimeoutError as e:
        die("no Gmail state: %s" % e)
    if text is None:
        die('no Gmail state: pipe in {"inbox": [Message-ID, ...], "unread": [Message-ID, ...]}')
    try:
        gmail_state = json.loads(text)
    except ValueError as e:
        die("the Gmail state is not JSON: %s" % e)
    result = mailbox.sync(ctx.st, ctx.cfg, gmail_state, time.time())
    print("mailbox sync: %d threads archived and %d read in the tab; Gmail to archive %d mails and mark %d read"
          % (result["archived"], result["read"], len(result["gmail"]["archive"]), len(result["gmail"]["read"])),
          file=sys.stderr)
    return emit(result)


def do_mailbox_answer(ctx, a):
    owner_only(ctx, "mailbox answer")
    try:
        text = piped.piped_text()
    except TimeoutError as e:
        die("no reply: %s" % e)
    if text is None:
        die("no reply: pipe its text in" + (', as {"text": ..., "files": [...]}' if a.json else ""))
    files = []
    if a.json:
        try:
            text, files = mailbox.answer_input(json.loads(text))
        except ValueError as e:
            die("the reply is not JSON: %s" % e)
    return emit(mailbox.answer(ctx.st, ctx.cfg, a.thread, a.key, text, files))


def do_mailbox_part(ctx, a):
    return emit(mailbox.part(ctx.st, a.key, a.index))


def do_mailbox_summary(ctx, a):
    return emit(mailbox.summary(ctx.st, ctx.cfg, time.time()))


def do_mailbox_backfill(ctx, a):
    return 1 if mailbox.backfill(ctx.st, ctx.svc, a.limit, print) else 0


def do_backup(ctx, a):
    if not ctx.cfg["backup"]["targets"]:
        die("config backup.targets is empty: list the directories to copy the mailroom to, each on another disk than "
            "%s (README.md, \"The Mail tab's mailbox\")" % config.STATE_DIR)
    ok, line = backup.run(ctx.st, ctx.cfg["backup"]["targets"], time.time())
    print(line)
    return 0 if ok else 1


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agent-mail", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    mail = argparse.ArgumentParser(add_help=False)    # the options send and reply share
    mail.add_argument("--body-file")
    mail.add_argument("--html", help="HTML alternative body file (default: rendered from the text body)")
    mail.add_argument("--image", action="append", metavar="NAME=PATH",
                      help="inline image (PNG/JPEG/GIF/WebP); place it with <img src=\"cid:NAME\">, else it goes at the end")
    mail.add_argument("--attach", action="append", metavar="PATH", help="ordinary attachment (PDF, zip, CSV...)")
    mail.add_argument("--no-review", metavar="WHY",
                      help="skip the pre-send review, recording WHY (urgent, or you disagree with its pushback)")
    mail.add_argument("--session", help="sending session name or id (default: this Claude session)")
    mail.add_argument("--request-id", help="reuse a proxy request UUID only when checking an uncertain send")
    mail.add_argument("--cli", choices=config.CLIS)

    p = sub.add_parser("send", parents=[mail], help="send a new email")
    recipient = "an address, or owner (or config owner_name) for the owner's address"
    p.add_argument("--to", required=True, help=recipient)
    p.add_argument("--cc", help=recipient)
    p.add_argument("--subject", required=True)
    p.add_argument("--unrouted", action="store_true",
                   help="no session, no reply tag; replies land at the orchestrator (for reports and alerts)")
    p.set_defaults(fn=do_send)

    p = sub.add_parser("reply", parents=[mail], help="answer an inbound mail, in its thread unless --subject")
    p.add_argument("inbound_id", type=int)
    p.add_argument("--subject", help="answer as a new thread under this subject, with a last line that names the "
                                     "old thread and links to the mail answered (for a thread whose subject no "
                                     "longer fits)")
    p.set_defaults(fn=do_reply)

    p = sub.add_parser("guide", help="how to write mail to the owner (the rules the pre-send review checks)")
    p.set_defaults(fn=do_guide)

    p = sub.add_parser("withdraw", help="drop your mail that the pre-send review sent back, so it is never sent")
    p.add_argument("--session")
    p.add_argument("--cli", choices=config.CLIS)
    p.set_defaults(fn=do_withdraw)

    p = sub.add_parser("flush-drafts", help=argparse.SUPPRESS)
    p.set_defaults(fn=do_flush_drafts)

    p = sub.add_parser("sent", help="list outbound mail")
    p.add_argument("--limit", type=int, default=30)
    p.set_defaults(fn=do_sent)

    p = sub.add_parser("inbox", help="list inbound mail the mailroom has seen")
    p.add_argument("--held", action="store_true")
    p.add_argument("--limit", type=int, default=50)
    p.set_defaults(fn=do_inbox)

    p = sub.add_parser("show", help="show one inbound mail")
    p.add_argument("inbound_id", type=int)
    p.set_defaults(fn=do_show)

    p = sub.add_parser("release", help="deliver a held mail to a session")
    p.add_argument("inbound_id", type=int)
    p.add_argument("target", help="session name or id, or 'origin': the session the mail was matched to")
    p.add_argument("--cli", choices=config.CLIS)
    p.add_argument("--host", help="the machine (config remote_hosts) whose session gets it; needs --cli and the full "
                                  "session UUID")
    p.set_defaults(fn=do_release)

    p = sub.add_parser("rerun", help="run the orchestrator again on a held or failed inbound mail")
    p.add_argument("inbound_id", type=int)
    p.set_defaults(fn=do_rerun)

    p = sub.add_parser("status", help="mailroom status")
    p.set_defaults(fn=do_status)

    p = sub.add_parser("rpc", help=argparse.SUPPRESS)
    p.set_defaults(fn=do_rpc)

    p = sub.add_parser("search-local", help=argparse.SUPPRESS)
    p.set_defaults(fn=do_search_local)

    p = sub.add_parser("receipt", help="inspect the outcome of a proxy send without resending")
    p.add_argument("request_id")
    p.set_defaults(fn=do_receipt)

    p = sub.add_parser("recover", help="read-only desktop-then-Mac search for an unowned reply")
    p.add_argument("inbound_id", type=int)
    p.add_argument("--query", action="append", help="additional literal artifact ID or exact title")
    p.add_argument("--refresh", action="store_true", help="explicitly repeat a previously saved search")
    p.set_defaults(fn=do_recover)

    p = sub.add_parser("mailbox", help="the owner's mailbox of agent mail, as JSON, for the board's Mail tab")
    box = p.add_subparsers(dest="mailbox_cmd", required=True)
    q = box.add_parser("list", help="threads in a box, newest first, and the counts")
    q.add_argument("--box", choices=mailbox.BOXES + ("all",), default="inbox")
    q.add_argument("--query", help="words that must all appear in a thread's subjects, agents' names or text")
    q.add_argument("--limit", type=int, default=100)
    q.set_defaults(fn=do_mailbox_list)
    q = box.add_parser("show", help="one thread: its messages and the thread as one sanitized HTML document")
    q.add_argument("thread")
    q.set_defaults(fn=do_mailbox_show)
    q = box.add_parser("mark", help="read, unread, archive, back to the inbox or snooze threads (not in an agent)")
    q.add_argument("threads", nargs="+")
    q.add_argument("--op", choices=mailbox.OPS, required=True)
    q.add_argument("--upto", type=int, help="read, archive, snooze: the newest agent mail id the tab showed")
    q.add_argument("--until", type=float, help="snooze: when it comes back, epoch seconds")
    q.set_defaults(fn=do_mailbox_mark)
    q = box.add_parser("sync", help="bring the tab and the owner's Gmail into step, its state piped in as JSON; prints what "
                                    "Gmail must change (not in an agent)")
    q.set_defaults(fn=do_mailbox_sync)
    q = box.add_parser("answer", help="the owner's reply in a thread, piped in; the mailroom routes it (not in an agent)")
    q.add_argument("thread")
    q.add_argument("--key", required=True, help="the tab's key for this reply: a retry with it answers once")
    q.add_argument("--json", action="store_true",
                   help='the reply piped in is {"text": TEXT, "files": [{"name": NAME, "data": BASE64}, ...]}')
    q.set_defaults(fn=do_mailbox_answer)
    q = box.add_parser("part", help="one attachment or inline part of a stored message, base64")
    q.add_argument("key", help="the message's key: agent mail s<sent id>, or a reply with files i<inbound id>")
    q.add_argument("index", type=int)
    q.set_defaults(fn=do_mailbox_part)
    q = box.add_parser("summary", help="the unread and inbox counts, and the agent mail the tab counts as read")
    q.set_defaults(fn=do_mailbox_summary)
    q = box.add_parser("backfill", help="keep the messages of mail sent before the message store, from Gmail")
    q.add_argument("--limit", type=int, help="at most this many, newest first (default: all)")
    q.set_defaults(fn=do_mailbox_backfill)

    p = sub.add_parser("backup", help="copy the message store and the database to config backup.targets")
    p.set_defaults(fn=do_backup)

    a = ap.parse_args(argv)
    ctx = outbound.Context(config.load())
    try:
        if ctx.cfg.get("mail_proxy") and a.cmd not in ("rpc", "guide"):
            if a.cmd not in rpc.PROXY_ACTIONS:
                die("run this administrative command on the desktop")
            return do_proxy(ctx, a)
        return a.fn(ctx, a)
    except MailError as e:
        die(str(e), e.exit_code)
    except (NoToken, ConfigError) as e:   # not set up yet: say what to do instead of a traceback
        die(str(e))


if __name__ == "__main__":
    sys.exit(main())
