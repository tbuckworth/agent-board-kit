#!/usr/bin/env python3
"""agent-status: the status log and the "what are my agents up to" report.

    agent-status note TEXT...              record a milestone for this session (free; no model)
    agent-status report [--since 24h] [--format text|md|html|json] [--email TO] [--narrative FILE]
    agent-status log [--since 24h] [--session NAME_OR_ID] [--event note|idle|quota|...]
    agent-status hook --cli claude|codex   (hook entry point; reads the hook JSON on stdin)

Notes are for milestones, blockers and finished work the owner would want to know about.
Inside Claude the session is found from CLAUDE_CODE_SESSION_ID; inside Codex from the
working directory (pass --session to be explicit).
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import registry, report, statuslog  # noqa: E402

QUOTA_TYPES = ("quota_auto_resume_fired", "quota_auto_resume_stale", "quota_auto_resume_disabled")
LIMIT_ERRORS = ("rate_limit", "billing_error", "account_on_hold")   # StopFailure errors that are the plan's limits


def cmd_note(a):
    text = " ".join(a.text).strip()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read().strip()
    if not text:
        print("agent-status: empty note", file=sys.stderr)
        return 1
    ident = statuslog.identity(cli=a.cli, session_id=None if not a.session else _resolve(a.session, a.cli))
    ev = statuslog.append(dict(ident, event="note", text=text[:1000]))
    who = ev["name"] or ev["session_id"][:8] or "no session"
    print("noted for %s %s: %s" % (ev["cli"], who, text[:80]))
    return 0


def _resolve(spec, cli):
    s, code, _ = registry.resolve(spec, cli)
    if code != 0:
        print("agent-status: cannot resolve --session %r" % spec, file=sys.stderr)
        sys.exit(4)
    return s["id"]


def cmd_hook(a):
    """Never fails, never prints: a broken status log must not disturb the agent."""
    try:
        raw = sys.stdin.read()
        d = json.loads(raw) if raw.strip() else {}
        kind = d.get("hook_event_name", "")
        event = {"Stop": "idle", "SessionStart": "start", "SessionEnd": "end"}.get(kind)
        if kind == "StopFailure":   # a turn ended on an API error; agent-failover acts on the transcript itself
            event = "limit" if d.get("error") in LIMIT_ERRORS else "api-error"
        if kind == "Notification":
            if d.get("notification_type") in QUOTA_TYPES:
                event = "quota"
            else:
                return 0
        if not event:
            return 0
        sid = d.get("session_id") or d.get("thread_id") or ""
        cwd = d.get("cwd") or os.getcwd()
        ident = statuslog.identity(cli=a.cli, session_id=sid, cwd=cwd)
        ev = dict(ident, event=event)
        if event == "quota":
            ev["text"] = d.get("notification_type", "")
        if event == "end" and d.get("reason"):
            ev["text"] = str(d.get("reason"))[:80]
        if kind == "StopFailure":
            ev["text"] = ("%s: %s" % (d.get("error", "unknown"), d.get("error_details") or ""))[:200]
        statuslog.append(ev)
    except Exception:
        pass
    return 0


def cmd_log(a):
    since = statuslog.parse_since(a.since)
    sid = _resolve(a.session, None) if a.session else None
    for e in statuslog.read(since=since, session_id=sid, event=a.event, limit=a.limit):
        ts = time.strftime("%m-%d %H:%M:%S", time.localtime(e.get("ts", 0)))
        print("%s %-6s %-5s %-30s %s%s" % (ts, e.get("cli", "?"), e.get("event", ""), (e.get("name") or e.get("session_id", "")[:8])[:30],
                                          ("@" + e["branch"] + " ") if e.get("branch") else "", e.get("text", "")))
    return 0


def cmd_report(a):
    since = statuslog.parse_since(a.since) or (time.time() - 86400)
    rep = report.gather(since_seconds=time.time() - since)
    narrative = Path(a.narrative).read_text() if a.narrative else None
    if a.format == "json":
        body = json.dumps(rep, indent=2, default=str)
    elif a.format == "md":
        body = report.render_markdown(rep)
    elif a.format == "html":
        body = report.render_html(rep, narrative)
    else:
        body = report.render_text(rep)
    if not a.email:
        print(body)
        return 0
    html_body = report.render_html(rep, narrative)
    text_body = (narrative + "\n\n" if narrative else "") + report.render_text(rep)
    with tempfile.TemporaryDirectory() as td:
        hp, tp = Path(td) / "r.html", Path(td) / "r.txt"
        hp.write_text(html_body)
        tp.write_text(text_body)
        mail = Path(__file__).resolve().parent / "agent-mail"
        subject = a.subject or "Agents on %s: %d live, %d waiting" % (rep["host"], rep["live"], rep["waiting"])
        cmd = [sys.executable, str(mail), "send", "--to", a.email, "--subject", subject, "--body-file", str(tp), "--html", str(hp)]
        cmd += ["--session", a.session] if a.session else ["--unrouted"]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        print((r.stdout + r.stderr).strip())
        return r.returncode


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agent-status", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("note", help="record a milestone for this session")
    p.add_argument("text", nargs="*")
    p.add_argument("--session", help="session name or id (default: this session, or the one in this directory)")
    p.add_argument("--cli", choices=["claude", "codex"])
    p.set_defaults(fn=cmd_note)

    p = sub.add_parser("hook", help="hook entry point (stdin JSON)")
    p.add_argument("--cli", choices=["claude", "codex"], required=True)
    p.set_defaults(fn=cmd_hook)

    p = sub.add_parser("log", help="print events")
    p.add_argument("--since", default="24h")
    p.add_argument("--session")
    p.add_argument("--event")
    p.add_argument("--limit", type=int)
    p.set_defaults(fn=cmd_log)

    p = sub.add_parser("report", help="what every agent is up to")
    p.add_argument("--since", default="24h")
    p.add_argument("--format", choices=["text", "md", "html", "json"], default="text")
    p.add_argument("--email", help="send the report to this address (HTML + text)")
    p.add_argument("--subject")
    p.add_argument("--narrative", help="file with a short paragraph to put above the table")
    p.add_argument("--session", help="send the mail from this session (default: unrouted, replies go to the orchestrator)")
    p.set_defaults(fn=cmd_report)

    a = ap.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
