#!/usr/bin/env python3
"""agent-mailroom: route the replies the owner writes in the Mail tab, and the agents Gmail inbox's mail when Gmail is
on (a reMarkable document among it), to sessions, end fast mode on a Mail-tab thread when its time is up, and send
the Mail tab's Researcher controls to their agents.

    agent-mailroom            run forever (systemd/agent-mailroom.service)
    agent-mailroom --once     one poll (with Gmail off: one pass), then exit
    agent-mailroom --dry-run  decide and log, but deliver nothing and change no labels
    agent-mailroom --baseline reset the Gmail history cursor to now (ignore anything older); Gmail only

With Gmail off in config ("gmail": false) it needs no token and never calls Gmail: each pass routes the Mail tab's
replies and does everything else a poll does. Details: README.md, sections "Running without Gmail", "The mailroom",
"Sender tiers, DKIM, collaborators", "reMarkable documents", "Researcher mode" and "The Mail tab's mailbox".
"""
import argparse
import fcntl
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import (alerts, config, deliver, fastmode, gmail, groupmail, mailroom, orchestrate,  # noqa: E402
                       outbound, recovery, remarkable, researchermode, review, routing, statuslog)
from agentmail.groups import GroupError  # noqa: E402
from agentmail.watch import log  # noqa: E402
from agentmail.store import Store  # noqa: E402

STOP = False
# When Gmail has dropped the history cursor, the inbox is searched from the last poll for at most this many messages.
RESCAN_LIMIT = 1000


def on_signal(signum, frame):
    global STOP
    STOP = True
    log("signal %d, finishing the current message before stopping" % signum)


def process(svc, st, cfg, gid, dry_run):
    """Gmail message gid, once: read it, skip the agents account's own mail, record it (pending) with the session the
    routing slip finds (mailroom.claim), put reMarkable mail through its route, hold a sender on neither list or
    without a DKIM pass, and route the rest (route)."""
    if st.seen(gid):
        return
    msg = gmail.get_full(svc, gid)
    hdrs = gmail.headers(msg)
    from_name, from_addr = routing.sender(hdrs.get("from", ""))
    subject = hdrs.get("subject", "")
    thread_id = msg.get("threadId")

    if from_addr == cfg["account"]:
        st.record_inbound(gmail_id=gid, thread_id=thread_id, message_id=hdrs.get("message-id"),
                          from_addr=from_addr, from_name=from_name, subject=subject,
                          action="skipped", detail="own message")
        log("skip   %s from ourselves: %r" % (gid, subject))
        return

    body = routing.strip_quotes(gmail.body_text(msg))
    session, rule = mailroom.claim(st, hdrs, thread_id, cfg["account"])
    tier = routing.sender_tier(from_addr, cfg)
    auth = gmail.auth_results(hdrs)
    inbound_id = st.record_inbound(
        gmail_id=gid, thread_id=thread_id, message_id=hdrs.get("message-id"),
        from_addr=from_addr, from_name=from_name, subject=subject,
        matched_tag=session["tag"] if session else None, match_rule=rule, action="pending", body=body,
        in_reply_to=routing.direct_reply_parent(gmail.all_headers(msg)))

    if remarkable.is_sender(cfg["remarkable"], from_addr):
        status, detail = remarkable.handle(svc, cfg, inbound_id, msg, from_name, from_addr, subject, auth, dry_run)
        log("%s #%d from %s %r: %s" % ({"started": "remark", "dry-run": "would"}.get(status, "hold  "),
                                       inbound_id, from_addr, subject, detail))
        if dry_run:
            st.update_inbound(inbound_id, action="dry-run", detail=detail)
        else:
            remarkable.record(svc, st, cfg, inbound_id, gid, status, detail, from_addr, subject)
        return
    refused = mailroom.sender_hold(cfg, tier, from_addr, auth, subject, inbound_id)
    if refused:
        detail, alert = refused
        return hold_mail(svc, st, cfg, st.inbound(inbound_id), rule, detail, alert, dry_run)
    route(svc, st, cfg, st.inbound(inbound_id), tier, dry_run)


def process_local(svc, st, cfg, row, dry_run):
    """A reply the owner wrote in the Mail tab (inbound row row, which `agent-mail mailbox answer` recorded with action
    "local" and the session the routing slip found): made pending first, so that a crash never routes it twice, as a
    Gmail mail is recorded pending, then routed as the owner's mail (route), with no DKIM check, since it came in through no
    mail server. It has no Gmail copy, so it gets no labels (mailroom.label)."""
    if not st.take_local_reply(row["id"]):
        return
    log("tab    #%d from %s %r: a reply written in the Mail tab" % (row["id"], row["from_addr"], row["subject"]))
    route(svc, st, cfg, st.inbound(row["id"]), "owner", dry_run)


def log_hold(svc, st, cfg, row, rule, detail, alert, dry_run):
    """Log the hold of inbound mail row, already saved, under routing rule rule, and send alert (alerts.send_alert's
    kind, key, subject and body, or None) unless dry_run."""
    log("hold   #%d from %s %r: %s (match %s)" % (row["id"], row["from_addr"], row["subject"], detail, rule or "none"))
    if alert and not dry_run:
        alerts.send_alert(svc, st, cfg, *alert)


def hold_mail(svc, st, cfg, row, rule, detail, alert, dry_run):
    """Hold inbound mail row with detail, labelled held unless dry_run (mailroom.set_state), then log_hold."""
    mailroom.set_state(svc, st, cfg, row["id"], row["gmail_id"], "held", not dry_run, detail=detail)
    log_hold(svc, st, cfg, row, rule, detail, alert, dry_run)


def route(svc, st, cfg, row, tier, dry_run):
    """Route inbound mail row, recorded pending with the session the routing slip found (matched_tag, match_rule),
    from a sender of tier ("owner" or "collaborator"): a reply to a group's mail is posted in the group; a
    collaborator's mail may be held by the flood and loop guards; mail a session claimed is delivered to it, and the
    owner's mail to a session that has gone goes to the orchestrator (the orphan fallback); the rest goes to the
    orchestrator, with the thread (mailroom.thread_messages). Gmail mail (process) and replies written in the Mail
    tab (process_local) both come here. The files of a Mail-tab reply go to the machine of the session it is
    delivered to, or of the orchestrator, first (mailroom.delivered_body); files that cannot be put there make a failed
    delivery, which is held."""
    inbound_id, gid, thread_id, rule = row["id"], row["gmail_id"], row["thread_id"], row["match_rule"]
    from_name, from_addr, subject, body = row["from_name"], row["from_addr"], row["subject"], row["body"]
    session = st.session_by_tag(row["matched_tag"]) if row["matched_tag"] else None
    collab = cfg["collaborators"].get(from_addr, {}) if tier == "collaborator" else {}
    who_name = collab.get("name") or from_name

    def held(detail, alert=None):
        """Log a hold already saved, and send its alert."""
        log_hold(svc, st, cfg, row, rule, detail, alert, dry_run)

    def hold(detail, alert=None):
        hold_mail(svc, st, cfg, row, rule, detail, alert, dry_run)

    if session is not None and session["cli"] == routing.GROUP_CLI:
        return post_in_group(svc, st, cfg, inbound_id, gid, session, tier, from_addr, subject, body, dry_run, hold)

    def fetch_thread():
        """The thread's messages and their transcript for the event text. A fetch that fails raises
        (hold_after_error holds the mail): without the thread the loop guard counts nothing."""
        msgs = mailroom.thread_messages(svc, st, row) if thread_id else []
        return msgs, routing.thread_context(msgs, cfg["account"], cfg["collaborators"]) if msgs else ""

    # thread transcript: for the orchestrator always; for a session only when a collaborator wrote
    thread_msgs, thread_txt = fetch_thread() if session is None or tier == "collaborator" else ([], "")
    if session is None and any(routing.is_alert(h, cfg["account"]) for h, _b, _ts, _gid in thread_msgs):
        rule = "mailroom-notice"
        st.update_inbound(inbound_id, match_rule=rule)

    if tier == "collaborator":
        run = routing.trailing_agent_run(thread_msgs, cfg["account"], cfg["collaborators"]) if thread_msgs else 0
        refused = mailroom.collaborator_hold(cfg, who_name, from_addr, subject, thread_id, inbound_id,
                                             st.count_from_since(from_addr, time.time() - 3600), run)
        if refused:
            return hold(*refused)
        if cfg["notify_owner_new_collab_thread"] and thread_id and not st.thread_seen_before(thread_id, gid) and not dry_run:
            alerts.send_alert(svc, st, cfg, "collab-thread", thread_id,
                              "%s started a thread: %s" % (who_name, subject),
                              "From %s. First message:\n\n%s\n\nNo action needed; this is the visibility notice for a new "
                              "agent-to-agent thread. It is being handled by %s." % (
                                  from_addr, body[:1500], ("session %s" % (session["session_name"] or session["session_id"][:8])) if session else "the orchestrator"))

    gone = None   # the closed session, when the owner's mail to it goes to the orchestrator instead
    if session is not None:
        who = "%s@%s %s [%s]" % (session["cli"], session["origin_host"], session["session_name"] or "", session["session_id"][:8])
        if dry_run:
            log("would deliver #%d (%s) from %s %r -> %s via %s" % (inbound_id, tier, from_addr, subject, who, rule))
            st.update_inbound(inbound_id, action="dry-run", detail="would deliver to " + who)
            return
        try:
            delivered, files = mailroom.delivered_body(cfg, row, session["origin_host"])
        except mailroom.FILES_NOT_PLACED as e:   # a failed delivery: held, and the owner told
            rc, out = 1, "the files were not put on %s: %s" % (session["origin_host"], e)
        else:
            if files:
                log("files  #%d: %d put on %s for %s" % (inbound_id, len(files), session["origin_host"], who))
            text = routing.event_text("session", tier, inbound_id, from_name, from_addr, collab, subject, delivered,
                                      thread_txt, cfg["owner_name"],
                                      reminder=mailroom.owner_reminder(st, cfg, tier, inbound_id, body, session))
            rc, out = mailroom.deliver_to_session(svc, st, cfg, inbound_id, gid, session, text, tier, True)
        if rc == 0:
            log("deliver #%d (%s) from %s %r -> %s via %s: %s" % (inbound_id, tier, from_addr, subject, who, rule, out))
            return
        if tier != "owner" or rc not in deliver.SESSION_GONE:
            hold("delivery failed (%d): %s" % (rc, out))
            recovery.hold_delivery(st, st.inbound(inbound_id), session, "delivery failed (%d): %s" % (rc, out))
            recovery.notify(svc, st, cfg, st.inbound(inbound_id))
            return
        # the orphan fallback: the session has closed or exited, so the owner's mail goes to the orchestrator
        gone = ("%s, " % session["session_name"] if session["session_name"] else "") + "%s session %s on %s" % (
            session["cli"], session["session_id"][:8], session["origin_host"])
        rule = "orphan-thread"
        st.update_inbound(inbound_id, match_rule=rule, detail="session gone (%d): %s" % (rc, out))
        log("orphan #%d from %s %r: %s is gone (%d: %s); to the orchestrator" % (inbound_id, from_addr, subject, who,
                                                                               rc, out))
        thread_msgs, thread_txt = fetch_thread()

    # ---- nobody claimed it: the orchestrator
    new_rule, unowned_reply, context = mailroom.orchestrator_context(
        rule, tier, inbound_id, thread_msgs, st.sent_rows_in_thread(thread_id) if thread_id else [], cfg)
    if new_rule != rule:
        rule = new_rule
        st.update_inbound(inbound_id, match_rule=rule)
    if dry_run:
        log("would run orchestrator for #%d (%s) from %s %r" % (inbound_id, tier, from_addr, subject))
        st.update_inbound(inbound_id, action="dry-run", detail="would run the orchestrator")
        return
    delivered, files = mailroom.delivered_body(cfg, row, cfg["host_id"])   # raises: held (hold_after_error)
    if files:
        log("files  #%d: %d put here for the orchestrator" % (inbound_id, len(files)))
    text = routing.event_text("orphan" if gone else "orchestrator", tier, inbound_id, from_name, from_addr, collab,
                              subject, delivered, thread_txt, cfg["owner_name"], gone) + context
    mailroom.set_state(svc, st, cfg, inbound_id, gid, "orchestrating", True, match_rule="orchestrator", detail="run started")
    info = orchestrate.run_event(text, "mail", cfg)
    outcome, detail = mailroom.settle_run(svc, st, cfg, inbound_id, gid, info, "orchestrator run", unowned_reply, True)
    if outcome == "retained":
        log("explicit handoff of #%d retained" % inbound_id)
    elif outcome == "unowned":
        log("held unowned reply #%d after recovery; orchestrator ok=%s" % (inbound_id, info["ok"]))
    elif outcome == "recovery":
        log("held   #%d: recovery saved during the run; orchestrator ok=%s: %s" % (inbound_id, info["ok"], detail))
    elif outcome == "delivered":
        log("orchestrated #%d (%s) from %s %r: %s" % (inbound_id, tier, from_addr, subject, detail))
    elif outcome == "failed":
        held(st.inbound(inbound_id)["detail"],
             alert=("orchestrator-fail", "run", "orchestrator run failed on mail #%d" % inbound_id,
                    "The orchestrator couldn't finish handling your email. Nothing has been lost: the email is "
                    "saved %s. It may have done part of the work before stopping.\n\n"
                    "Reply here if you need help continuing. Delivery stays on hold until someone checks what "
                    "was done and fixes the problem; you don't need to resend your email.\n\n"
                    "From: %s\nSubject: %s\nFor diagnosis: %s\nSaved mail: agent-mail show %d\n"
                    "After checking the outcome: agent-mail rerun %d." % (routing.saved_where(gid), from_addr, subject,
                                                                          detail, inbound_id, inbound_id)))
    else:
        raise ValueError("settle_run gave an unknown outcome %r" % outcome)


def post_in_group(svc, st, cfg, inbound_id, gid, group_row, tier, from_addr, subject, body, dry_run, hold):
    """A reply to a group's mail (groupmail): the owner's becomes their post in the group; anyone else's is held. A
    reply of theirs that cannot be posted (an empty one, say) is held, and they are told why."""
    title = group_row["session_name"]
    if tier != "owner":
        return hold("a reply to the mail of group %r from %s: only %s posts in a group by mail"
                    % (title, from_addr, cfg["owner_name"]))
    if dry_run:
        log("would post #%d from %s in group %r" % (inbound_id, from_addr, title))
        st.update_inbound(inbound_id, action="dry-run", detail="would post in group %r" % title)
        return
    try:
        out = groupmail.post_reply(cfg, group_row["session_id"], body, gid)
    except GroupError as e:
        return hold("not posted in group %r: %s" % (title, e),
                    alert=("group-post", str(inbound_id), "your reply to group %r was not posted" % title,
                           "Your reply (subject %r) was not posted in the group: %s\n\nThe mail is saved: agent-mail "
                           "show %d. Reply to the group's mail again, or post on the Agent Board." % (subject, e,
                                                                                              inbound_id)))
    mailroom.set_state(svc, st, cfg, inbound_id, gid, "delivered", True, detail=out.splitlines()[0])
    log("group  #%d from %s posted in %r:\n%s" % (inbound_id, from_addr, title, out.rstrip()))


def hold_after_error(svc, st, cfg, gid, e, dry_run):
    """process() or process_local() raised e on the mail of Gmail id gid (a Mail-tab reply's: routing.local_gmail_id).
    Mail it saved but had not settled (pending or orchestrating) is held with the error, labelled held (but for a
    Mail-tab reply: mailroom.label), and the owner is alerted, once per error type per alerts.DEDUPE_SECONDS. A row that
    already records an outcome keeps it; mail it never saved gets an "error" row. A label or alert that fails here is
    logged as ERROR."""
    reason = "%s: %s" % (type(e).__name__, e)
    row = st.inbound_by_gmail_id(gid)
    if row is None:
        log("error  %s: %s" % (gid, reason))
        st.record_inbound(gmail_id=gid, action="error", detail=reason)
        return
    if row["action"] not in ("pending", "orchestrating"):
        log("error  %s (#%d, already %s; kept): %s" % (gid, row["id"], row["action"], reason))
        return
    mailroom.set_state(svc, st, cfg, row["id"], gid, "held", False, detail="error: " + reason)
    log("error  %s (#%d held): %s" % (gid, row["id"], reason))
    if dry_run:
        return
    try:
        mailroom.label(svc, cfg, gid, "held")
    except Exception as e2:
        log("ERROR  #%d: could not label it held: %s: %s" % (row["id"], type(e2).__name__, e2))
    group = st.session_by_tag(row["matched_tag"]) if row["matched_tag"] else None
    if remarkable.is_sender(cfg["remarkable"], row["from_addr"]):
        retry = "agent-mail remarkable %d" % row["id"]
    elif group is not None and group["cli"] == routing.GROUP_CLI:   # a reply to a group's mail: nobody reruns it
        retry = "%s, with the reply's text" % groupmail.post_command(cfg, group["session_id"])
    else:
        retry = "agent-mail rerun %d (the orchestrator) or agent-mail release %d <session>" % (row["id"], row["id"])
    try:
        alerts.send_alert(svc, st, cfg, "process-error", type(e).__name__, "mail #%d hit an error and is held" % row["id"],
                          "The mailroom hit an error while handling an email and stopped. Nothing has been lost: the "
                          "email is saved %s. It may have been partly handled before the error.\n\n"
                          "From: %s\nSubject: %s\nFor diagnosis: %s\nSaved mail: agent-mail show %d\n"
                          "After fixing the cause: %s.\n\n"
                          "Other mail that fails with %s in the next %d hours is held without another alert; "
                          "agent-mail inbox --held lists it." % (
                              routing.saved_where(gid), row["from_addr"], row["subject"], reason, row["id"], retry,
                              type(e).__name__, alerts.DEDUPE_SECONDS // 3600))
    except Exception as e2:
        log("ERROR  #%d: could not alert %s: %s: %s" % (row["id"], cfg["owner_name"], type(e2).__name__, e2))


def rescan(svc, st, cfg, cursor, dry_run):
    """Gmail no longer has history from the saved cursor: search the inbox from the start of the last successful
    poll (when that cursor was read), at most RESCAN_LIMIT messages, and alert the owner that the gap was rescanned.
    Returns the ids, oldest first, and the history id to save. Raises if no poll was ever recorded."""
    since = st.get_meta("last_poll")
    if since is None:
        raise RuntimeError("history id %s is gone and no successful poll is recorded to search from; "
                           "agent-mailroom --baseline restarts from now, ignoring older mail" % cursor)
    # Read before searching: mail that arrives during the search comes in through history on the next poll.
    newest = str(gmail.profile(svc)["historyId"])
    q = "in:inbox after:%s" % since
    ids = gmail.search(svc, q, RESCAN_LIMIT)[::-1]   # Gmail lists newest first; handle mail in arrival order
    full = len(ids) >= RESCAN_LIMIT
    log("history id %s is gone; searched %r: %d message(s)%s" % (cursor, q, len(ids), "; stopped at the limit" if full else ""))
    if dry_run:
        return ids, newest
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(since)))
    # No catch: if the owner cannot be told, the poll stops before the cursor moves and the next poll rescans.
    alerts.send_alert(svc, st, cfg, "history-gone", cursor, "Gmail history lost; inbox since %s rescanned" % when,
                      "Gmail no longer had the mailroom's place in the inbox history (history id %s), so the "
                      "mailroom searched the inbox for mail since its last successful poll at %s (Gmail search: %s) "
                      "and found %d message(s). Mail it had already handled is skipped; the rest is handled as usual.%s"
                      % (cursor, when, q, len(ids),
                         "\n\nThe search stopped at %d messages, so mail older than the oldest of them was not "
                         "handled. Search the agents account for it with the same query." % RESCAN_LIMIT if full else ""))
    return ids, newest


def poll(svc, st, cfg, dry_run):
    """One poll: fast mode's pass, the agents inbox's new mail (Gmail on only: poll_gmail), the replies written in
    the Mail tab that wait, and the watchdog. With Gmail off (svc gmail.OFF) it asks Gmail nothing, and records its
    time as the store's meta last_pass. Returns how many mails and replies it handled."""
    started = int(time.time())
    if not dry_run:
        researchermode.tick(st, cfg, time.time())
        fast_pass(svc, st, cfg, counting=True)   # first, so that it runs while Gmail cannot be reached too
    if config.gmail_on(cfg):
        n = poll_gmail(svc, st, cfg, dry_run, started)
        if n is None:   # stopping: the rest of the poll waits for the next run
            return 0
    else:
        n = 0
        st.set_meta("last_pass", started)
    local = route_tab_replies(svc, st, cfg, st.local_replies_waiting(), dry_run)   # those left for a poll
    if not dry_run and not STOP:
        watchdog(svc, st, cfg)
    return n + local


def poll_gmail(svc, st, cfg, dry_run, started):
    """The Gmail part of a poll begun at started: each message added to the inbox since the history cursor (or found
    by rescan once Gmail has dropped it) processed, and the cursor and last_poll moved on. Returns how many there
    were, or None when the daemon is stopping before the last, keeping the old cursor."""
    start = st.get_meta("history_id")
    if not start:
        start = str(gmail.profile(svc)["historyId"])
        st.set_meta("history_id", start)
        log("baseline history_id %s; older mail is ignored" % start)
    try:
        ids, newest = gmail.history_since(svc, start)
    except gmail.HistoryGone:
        ids, newest = rescan(svc, st, cfg, start, dry_run)
    for gid in ids:
        if STOP:
            # Keep the old cursor: the next poll skips saved messages and picks up
            # the remainder. Advancing it here would silently drop that remainder.
            return None
        try:
            process(svc, st, cfg, gid, dry_run)
        except Exception as e:  # one bad message must not stall the queue
            hold_after_error(svc, st, cfg, gid, e, dry_run)
    st.set_meta("history_id", newest)
    st.set_meta("last_poll", started)
    return len(ids)


def route_tab_replies(svc, st, cfg, local, dry_run):
    """Route local, replies the owner wrote in the Mail tab that wait (Store.local_replies_waiting's rows),
    oldest first; one that fails is held (hold_after_error). A stopping daemon leaves the rest waiting, still "local".
    Returns how many there were."""
    for row in local:
        if STOP:
            break
        try:
            process_local(svc, st, cfg, row, dry_run)
        except Exception as e:
            hold_after_error(svc, st, cfg, row["gmail_id"], e, dry_run)
    return len(local)


def between_polls(svc, st, cfg, seconds, dry_run):
    """The wait of `seconds` before the next poll, a second at a time, so that a stop is seen within one. After each
    second, the replies written in the Mail tab that wait in a thread Gmail holds no mail of (with
    config mailbox.owner_delivery "local", a thread of agent mail to the owner alone), or with Gmail off in config every
    reply that waits, are routed (route_tab_replies), after fast mode's pass, whose failures count as no tries there:
    one reaches its session within about a second of its writing, asking Gmail nothing, whether Gmail can be reached
    or not. With Gmail on, a reply in a thread Gmail holds mail of waits for the next poll, as its route to the
    orchestrator reads that thread from Gmail (mailroom.thread_messages). Routing a reply here cannot pass Gmail mail
    of its thread not yet polled, as Gmail holds none of it. A failure is logged and tried again after the next
    second: a reply is taken before it is routed (process_local), so none goes twice."""
    gmail_on = config.gmail_on(cfg)
    for _ in range(int(seconds)):
        if STOP:
            return
        time.sleep(1)
        if not dry_run and not STOP:
            researchermode.tick(st, cfg, time.time())
        try:
            local = [r for r in st.local_replies_waiting()
                     if not (gmail_on and st.thread_in_gmail(r["thread_id"]))]
            if not local or STOP:
                continue
            if not dry_run:
                fast_pass(svc, st, cfg, counting=False)
            route_tab_replies(svc, st, cfg, local, dry_run)
        except Exception as e:
            log("tab replies not routed between polls: %s: %s; tried again in a second" % (type(e).__name__, e))


def fast_pass(svc, st, cfg, counting):
    """Fast mode's pass (fastmode.tick), at the start of each poll and before the replies routed between polls, so
    before any mail is routed: end each fast mode whose time is up, putting the agent's effort back and telling it, and
    press the keys that wait for a dialog to close; its failures count as tries only when `counting` (at a poll). A
    failure is logged and tried again at the next pass."""
    try:
        for line in fastmode.tick(outbound.Context.opened(cfg, st, svc), time.time(), counting):
            log(line)
    except Exception as e:
        log("fast mode pass failed: %s: %s; tried again at the next pass" % (type(e).__name__, e))


def watchdog(svc, st, cfg):
    """After a poll, with no model call: alert the owner to quota events in the status log (the store's
    watchdog_quota_ts records how far it has read), retry the notices of held replies that failed to go out, mail
    the owner about each new group (groupmail.announce), send the drafts the pre-send review held past
    fallback_minutes by running `agent-mail flush-drafts`, and, with mail to the owner kept for the Mail tab alone and
    Gmail on, nudge them through Gmail when some is waiting (alerts.nudge)."""
    now = time.time()
    # quota notifications written to the status log by the Notification hook
    last = float(st.get_meta("watchdog_quota_ts", now - 3600))
    for e in statuslog.read(since=last, event="quota"):
        who = e.get("name") or e.get("session_id", "")[:8]
        if alerts.send_alert(svc, st, cfg, "quota", who, "usage limit hit by %s" % who,
                             "%s reported %s at %s in %s." % (who, e.get("text", "quota event"),
                                                             time.strftime("%H:%M", time.localtime(e.get("ts", now))), e.get("cwd", ""))):
            log("alert  quota event from %s" % who)
    st.set_meta("watchdog_quota_ts", now)
    # A transient alert failure must not strand a retained reply without a notice.
    for row in st.unnotified_recoveries(10):
        try:
            recovery.notify(svc, st, cfg, row)
        except Exception as e:
            log("reply #%s notification failed: %s" % (row["id"], e))
    # one mail to the owner for each new group, whose thread they post in by replying
    try:
        for g in groupmail.announce(svc, st, cfg):
            log("group  mailed %s about group %r (%s)" % (cfg["owner_name"], g.title, g.id))
    except Exception as e:
        log("group mail failed: %s: %s; tried again after the next poll" % (type(e).__name__, e))
    # mail the pre-send review sent back that its agent neither revised nor withdrew in time: send it as is
    if st.stale_drafts(now - 60 * review.settings(cfg)["fallback_minutes"]):
        try:
            r = subprocess.run([sys.executable, str(Path(__file__).resolve().parent / "agent-mail"), "flush-drafts"],
                               capture_output=True, text=True, timeout=300)
            for line in (r.stdout + r.stderr).splitlines():
                log("review " + line)
        except Exception as e:
            log("review flush-drafts failed: %s" % e)
    # with mail to the owner kept for the Mail tab alone: a content-free nudge through Gmail when some is waiting
    try:
        told = alerts.nudge(svc, st, cfg, time.time())
        if told:
            log("nudge  told %s of %d agent mail(s) in the Mail tab" % (cfg["owner_name"], told))
    except Exception as e:
        log("nudge failed: %s: %s; tried again after the next poll" % (type(e).__name__, e))


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agent-mailroom", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--baseline", action="store_true", help="reset the Gmail history cursor to now (Gmail only)")
    a = ap.parse_args(argv)

    try:
        cfg = config.load()
        config.require_account(cfg)
    except config.ConfigError as e:
        print("agent-mailroom: %s" % e, file=sys.stderr)
        return 2
    gmail_on = config.gmail_on(cfg)
    if not gmail_on and a.baseline:
        print('agent-mailroom: --baseline resets the Gmail history cursor, and Gmail is off in config ("gmail": false '
              "in %s)" % config.CONFIG_PATH, file=sys.stderr)
        return outbound.NEEDS_GMAIL
    if not cfg["allowlist"]:
        print("agent-mailroom: warning: config `allowlist` is empty, so %s. Add the owner's address to %s." % (
            "every inbound mail is held" if gmail_on else "the Mail tab shows no thread and agent mail to the owner is "
                                                          "refused", config.CONFIG_PATH), file=sys.stderr)
    for line in outbound.gmail_ignored(cfg):
        print("agent-mailroom: warning: Gmail is off, so this config takes no effect: %s" % line, file=sys.stderr)
    config.STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = open(config.LOCK_PATH, "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("agent-mailroom: another instance holds %s" % config.LOCK_PATH, file=sys.stderr)
        return 1

    st = Store()
    if gmail_on:
        try:
            svc = gmail.service()
        except gmail.NoToken as e:   # no token yet: say what to run instead of a traceback
            print("agent-mailroom: %s" % e, file=sys.stderr)
            return 2
        if a.baseline:
            hid = str(gmail.profile(svc)["historyId"])
            st.set_meta("history_id", hid)
            log("history cursor reset to %s" % hid)
        for name in cfg["labels"].values():
            gmail.ensure_label(svc, name)
        log("mailroom up: %s, allowlist %s, poll %ss%s" % (
            cfg["account"], ", ".join(cfg["allowlist"]), cfg["poll_seconds"], " (dry run)" if a.dry_run else ""))
    else:
        svc = gmail.OFF   # no token, no Gmail call: anything that tried one would raise gmail.GmailOff
        log("mailroom up: Gmail off, agent mail to the owner kept for the Mail tab; allowlist %s, pass every %ss%s" % (
            ", ".join(cfg["allowlist"]), cfg["poll_seconds"], " (dry run)" if a.dry_run else ""))

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    backoff = 0
    while not STOP:
        try:
            n = poll(svc, st, cfg, a.dry_run)
            backoff = 0
            if a.once:
                log("once: %d new message(s)" % n)
                break
        except Exception as e:
            backoff = min(300, (backoff or 15) * 2)
            log("poll error %s: %s; retrying in %ss" % (type(e).__name__, e, backoff))
            if gmail_on:
                try:
                    svc = gmail.service()
                except Exception as e2:
                    log("re-auth failed: %s" % e2)
            if a.once:
                return 1
        between_polls(svc, st, cfg, backoff or cfg["poll_seconds"], a.dry_run)
    log("mailroom down")
    return 0


if __name__ == "__main__":
    sys.exit(main())
