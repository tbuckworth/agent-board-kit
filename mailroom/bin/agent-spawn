#!/usr/bin/env python3
"""agent-spawn: start a Claude Code or Codex agent in a tmux session, in a fresh worktree.

    agent-spawn --repo NAME_OR_PATH --branch BRANCH [--base origin/main] BRIEF-OPTS
    agent-spawn --new-repo NAME [--branch B] [--org OWNER] [--public] BRIEF-OPTS
    agent-spawn --dir PATH BRIEF-OPTS                       # existing directory, no worktree
    BRIEF-OPTS: --brief FILE | --brief-text TEXT | brief on stdin; [--no-preamble]
    Common: [--cli claude|codex] [--account NAME|codex|auto] [--model M]
            [--effort low|medium|high|xhigh|max] [--name NAME] [--reuse]
            [--memory-max SIZE] [--swap-max SIZE] [--dry-run] [--json]

Claude runs with --dangerously-skip-permissions, Codex with -s danger-full-access -a never. A new Codex agent is
refused in a worktree whose main checkout lacks the worktree's .codex/hooks.json (Codex runs the main checkout's).
A --repo NAME and a --new-repo are under config repos_root (AGENT_SPAWN_ROOT overrides); a new repo is a private
GitHub repo under config github_owner (or --org), and the agent starts on its own branch in a worktree beside it.
If the fetch fails, the branch is made from origin's refs as the last good fetch left them, and the output
("base_warning") and the brief say so. If the agent does not get its brief, agent-spawn exits 1 with the reason
("error" in --json).
Details: README.md, section "Starting an agent".
"""
import argparse
import functools
import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import (accounts, cli, config, deliver, launch, memcap, piped, registry, reviewgate,  # noqa: E402
                       statuslog, usage, worktree)
from agentmail.commands import CommandError, checked, repo_root, run, tmux_has  # noqa: E402
from agentmail.trust import claude_json_for, ensure_trust  # noqa: E402

NEW_REPO_BRANCH = "initial"     # a new project's first branch, in its worktree beside the main folder
BASES = ("origin/main", "origin/master", "main", "master", "HEAD")   # a new branch's base: the first that exists
FETCH_TIMEOUT = 180             # one try: someone is usually waiting for the agent
AGENT_SEND = Path(__file__).resolve().parent / "agent-send"   # delivers the brief to a session that is running

die = functools.partial(cli.die, "agent-spawn")


def repos_root(cfg):
    """Where a --repo NAME is found and a --new-repo is made: AGENT_SPAWN_ROOT, else config repos_root."""
    return Path(os.environ.get("AGENT_SPAWN_ROOT") or os.path.expanduser(cfg["repos_root"]))


def slug(s):
    s = re.sub(r"[^A-Za-z0-9._/-]+", "-", s.strip()).strip("-")
    return s or "work"


def tmux_name(s):
    return re.sub(r"[.:\s]+", "-", s).strip("-")[:60]


def worktree_path(repo, branch):
    """A branch's worktree sits beside its repo, at <parent>/<repo>-<branch>."""
    return repo.parent / ("%s-%s" % (repo.name, branch.replace("/", "-")))


def choose_route(a, cfg, owner, read=None):
    """-> {cli, account, config_dir, routed, why, avoid}. Explicit --account, --cli or --model always win;
    usage decides only with --account auto, or when config spawn_route is "auto" and none of them was given.
    Stops agent-spawn when usage cannot be read or no login is usable (all excluded or not set up): never the
    default login instead, which an owner rule may exclude."""
    s = usage.settings(cfg)
    auto = a.account == "auto" or (not a.account and not a.cli and not a.model and cfg.get("spawn_route") == "auto")
    route = {"routed": False, "why": "", "avoid": []}
    if a.account and a.account != "auto":
        try:
            cli, acct = usage.parse_target(a.account, s)
        except ValueError as e:
            die(str(e))
        if a.cli and a.cli != cli:
            die("--cli %s contradicts --account %s" % (a.cli, a.account))
        route.update(cli=cli, account=acct, why="--account " + a.account)
    elif not auto:
        cli = a.cli or "claude"
        route.update(cli=cli, account=accounts.default_account(s) if cli == "claude" else None)
    else:
        only = a.cli or ("claude" if a.model else None)   # a --model is a Claude model unless --cli says otherwise
        # with no --model, a Claude agent may run any of config.claude_model_order, in turn (usage.recommend)
        models = dict(config.spawn_models(cfg), claude=a.model) if a.model else None
        try:
            snaps = (read or usage.snapshots)(cfg)
        except (OSError, ValueError) as e:
            die("cannot route by usage: reading usage failed (%s: %s)" % (type(e).__name__, e))
        rec = usage.recommend(snaps, cfg, models=models, owner=owner, only_cli=only)
        if not rec["use"]:
            die("cannot route by usage: " + rec["line"])
        route.update(cli=rec["cli"], account=rec["account"], routed=True, why=rec["line"], avoid=rec["avoid"],
                     model=rec["model"] if rec["cli"] == "claude" else None)
    acct = accounts.account(s, route["account"]) if route["cli"] == "claude" and route["account"] else {}
    route["config_dir"] = accounts.expand(acct.get("config_dir"))
    if route["config_dir"]:
        ok, why = accounts.account_ready(acct)
        if not ok:
            die("Claude account %s is not ready: %s" % (route["account"], why))
    return route


def parse_args(argv, cfg):
    ap = argparse.ArgumentParser(prog="agent-spawn", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    where = ap.add_mutually_exclusive_group(required=True)
    where.add_argument("--repo", help="existing repo: name under config repos_root, or a path")
    where.add_argument("--new-repo", help="create a GitHub repo of this name under config repos_root")
    where.add_argument("--dir", help="existing directory; no worktree, no branch")
    ap.add_argument("--branch", help="with --repo: branch to create (required); with --new-repo: the agent's "
                                     "first branch (default %s)" % NEW_REPO_BRANCH)
    ap.add_argument("--base", help="with --repo: start point (default origin/main)")
    ap.add_argument("--org", default=cfg["github_owner"],
                    help="with --new-repo: GitHub owner (default: config github_owner, %(default)s)")
    ap.add_argument("--public", action="store_true", help="with --new-repo: public instead of private")
    ap.add_argument("--reuse", action="store_true", help="use an existing worktree/tmux session instead of failing")
    ap.add_argument("--cli", choices=config.CLIS, help="default claude (or by usage, see --account)")
    ap.add_argument("--account", help="Claude login from config usage.claude_accounts, codex, or auto (by usage)")
    ap.add_argument("--model", help="default: config spawn_<cli>_model")
    ap.add_argument("--effort", choices=launch.EFFORTS,
                    help="default: config spawn_<cli>_effort")
    ap.add_argument("--name", help="session and tmux name (default: branch or repo name)")
    ap.add_argument("--memory-max", help="memory cap for this agent, e.g. 48G or off (default: config agent_memory_max)")
    ap.add_argument("--swap-max", help="swap cap for this agent (default: config agent_swap_max)")
    ap.add_argument("--brief", help="file with the brief")
    ap.add_argument("--brief-text", help="the brief as text")
    ap.add_argument("--no-preamble", action="store_true", help="send the brief exactly as given")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    return ap.parse_args(argv)


def plan_place(a, root):
    """Where the agent works and what it is called: {mode, repo, branch, path, name, ...} for --repo, --new-repo
    or --dir; a --repo name and a --new-repo are under root (repos_root). Stops agent-spawn on arguments that name no
    usable place."""
    if a.repo:
        if not a.branch:
            die("--repo needs --branch")
        repo = Path(a.repo).expanduser()
        if not repo.is_absolute() and not repo.exists():
            repo = root / a.repo
        repo = repo.resolve()
        if not (repo / ".git").exists():
            die("%s is not a git repository" % repo)
        branch = slug(a.branch)
        return dict(mode="worktree", repo=str(repo), branch=branch, path=str(worktree_path(repo, branch)),
                    name=tmux_name(a.name or branch.replace("/", "-")))
    if a.new_repo:
        if not a.org:
            die("--new-repo needs a GitHub owner: pass --org OWNER or set github_owner in %s" % config.CONFIG_PATH)
        rname = slug(a.new_repo).replace("/", "-")
        repo, branch = root / rname, slug(a.branch or NEW_REPO_BRANCH)
        return dict(mode="new-repo", repo=str(repo), branch=branch, path=str(worktree_path(repo, branch)),
                    name=tmux_name(a.name or rname), github="%s/%s" % (a.org, rname),
                    visibility="public" if a.public else "private")
    path = Path(a.dir).expanduser().resolve()
    if not path.is_dir():
        die("%s is not a directory" % path)
    return dict(mode="dir", path=str(path), name=tmux_name(a.name or path.name),
                branch=statuslog.git_facts(str(path))["branch"])


def plan_agent(a, cfg, plan):
    """Which CLI, login, model and effort (choose_route, then config): the plan's cli, account, config_dir, model,
    effort and, when usage or --account chose, route. The model is --model, else the one usage routing chose, else
    config spawn_<cli>_model; on a Claude login, accounts.move_model has the last word (a login with its own model
    runs it, and a --model it refuses stops agent-spawn). Runs git for the repo's owner; raises CommandError if it
    fails."""
    owner = a.org if a.new_repo else accounts.repo_owner(plan.get("repo") or plan["path"])
    route = choose_route(a, cfg, owner)
    cli = route["cli"]
    fresh = cfg[config.SPAWN_KEYS[cli]["model"]]
    model = a.model or route.get("model") or fresh
    if cli == "claude" and route["account"]:
        try:
            model = accounts.move_model(usage.settings(cfg), None, route["account"], a.model, model, fresh)
        except ValueError as e:
            die(str(e))
    out = dict(cli=cli, account=route["account"], config_dir=route["config_dir"], model=model,
               effort=a.effort or cfg[config.SPAWN_KEYS[cli]["effort"]])
    if route["routed"] or route["why"]:
        out["route"] = route["why"]
    return out


def make_place(a, plan):
    """Make the agent's folder: the worktree (after a fetch), or the new GitHub repo and its worktree; then trust
    it for both CLIs and link the login's auto memory. Adds base, base_warning, trusted and memory_link to the
    plan. Runs git and gh, and writes the trust files. Raises CommandError if a command fails."""
    path = Path(plan["path"])
    exists = path.exists()
    if exists and plan["mode"] != "dir" and not a.reuse:
        die("%s already exists (use --reuse)" % path, 3)
    if plan["mode"] == "worktree" and not exists:
        repo = Path(plan["repo"])
        base, warning = worktree.fetch_base(repo, (a.base,) if a.base else BASES, 1, FETCH_TIMEOUT, 0)
        if warning:   # the plan and the agent's brief say so too
            print("agent-spawn: warning: " + warning, file=sys.stderr)
            plan["base_warning"] = warning
        worktree.add(repo, path, plan["branch"], base)
        plan["base"] = base
    elif plan["mode"] == "new-repo" and not exists:
        repo = Path(plan["repo"])
        if repo.exists():
            if not a.reuse:
                die("%s already exists (use --reuse, or --repo for an existing repo)" % repo, 3)
        else:
            gh = registry.find_bin("gh", ["/usr/bin/gh", "/opt/homebrew/bin/gh"]) or die("gh not found")
            checked(run([gh, "repo", "create", plan["github"], "--" + plan["visibility"], "--clone", "--add-readme",
                         "--description", "Created by agent-spawn"], 180, cwd=str(repo.parent)), "gh repo create",
                    CommandError)
        worktree.add(repo, path, plan["branch"], "HEAD")
    try:
        plan["trusted"] = ensure_trust(plan["path"], claude_json_for(plan["config_dir"]))
    except (OSError, ValueError) as e:   # an untrusted folder would hold the agent at Claude's trust dialog
        die("cannot trust %s: %s" % (plan["path"], e))
    if plan["config_dir"]:   # same auto memory as the default login for this repo
        try:
            link = accounts.link_memory(repo_root(plan["path"]), plan["config_dir"], registry.DEFAULT_CLAUDE_HOME)
        except OSError as e:
            die("cannot link the default login's auto memory for %s: %s" % (plan["path"], e))
        if link:
            plan["memory_link"] = link


def write_brief(a, cfg, plan, brief):
    """Save the brief, after the protocol preamble unless --no-preamble (launch.write_brief, owner-only); its path
    goes into the plan."""
    head = "" if a.no_preamble else launch.preamble(cfg, plan["name"], plan["path"], plan.get("branch"), plan["cli"],
                                                      plan.get("base_warning", ""))
    brief_path = launch.write_brief(plan["name"], head + brief + "\n")
    plan["brief_path"] = str(brief_path)
    return brief_path


def start_agent(plan, brief_path, props):
    """Start the agent in a new tmux session with the brief as its first prompt or, if a session of that name is
    running (--reuse), send it the brief with agent-send. Adds tmux, the launch details and, if the agent did not
    get its brief, error to the plan. Stops agent-spawn before a new Codex agent whose worktree has a .codex/hooks.json
    its main checkout lacks, since Codex would run the main checkout's (reviewgate.codex_hooks_gap). Raises
    CommandError if tmux fails."""
    if tmux_has(plan["name"]):
        plan["tmux"] = "existing"
        plan["model"] = plan["effort"] = None  # the running session keeps its own; nothing was launched
        plan["account"] = plan["config_dir"] = None
        print("agent-spawn: tmux session %r exists; sending the brief as a message instead "
              "(--model/--effort not applied)" % plan["name"], file=sys.stderr)
        r = run([AGENT_SEND, "--from", "agent-spawn", plan["name"], brief_path.read_text()], 120)
        plan["delivery"] = (r.stdout + r.stderr).strip()
        if r.returncode == deliver.HELD:   # in the agent's queue, arriving at its next turn: sent, never to go again
            plan.setdefault("notes", []).append("the brief waits in Codex's queue: " +
                                                (plan["delivery"].splitlines() or ["agent-send gave no reason"])[-1])
        elif r.returncode != 0:
            plan["error"] = "agent-send could not deliver the brief to %r (exit %d): %s" % (
                plan["name"], r.returncode, plan["delivery"][:300])
        return
    gap = reviewgate.codex_hooks_gap(plan["path"]) if plan["cli"] == "codex" else None
    if gap:
        die("not starting Codex in %s: %s. Bring the main checkout up to date (or start Claude with --cli claude), "
            "then run this again with --reuse" % (plan["path"], gap))
    exe = registry.claude_bin() if plan["cli"] == "claude" else registry.codex_bin()
    if not exe:
        die("%s binary not found" % plan["cli"])
    target = launch.new_session(plan["name"], plan["path"])
    plan["tmux"] = plan["name"]
    plan["memory"] = launch.cap_pane(target, plan["name"], props)
    if plan["cli"] == "claude":
        plan["launch"] = launch.start_claude(target, exe, plan["name"], plan["config_dir"], plan["model"],
                                             plan["effort"], brief_path)
    else:
        plan.update(launch.start_codex(target, exe, plan["path"], plan["model"], plan["effort"],
                                       brief_path.read_text(), plan["name"]))


def report(a, plan, host_id):
    """The spawn event in the status log (with the failure, if any), then the plan as JSON or as a few lines, ending
    with how to attach to the agent's tmux session, here or from another machine."""
    statuslog.append({"cli": plan["cli"], "session_id": plan.get("thread") or "", "name": plan["name"],
                      "cwd": plan["path"], "branch": plan.get("branch", ""), "event": "spawn",
                      "account": plan.get("account") or "",
                      "text": "brief %s%s" % (plan["brief_path"],
                                              (": FAILED " + plan["error"]) if plan.get("error") else "")})
    if a.json:
        print(json.dumps(plan, indent=2))
        return
    if not plan.get("error"):   # with one, the agent has no brief: only where it is, then the failure
        if plan["tmux"] == "existing":
            how = "brief sent to the running session; model and effort unchanged"
        else:
            how = "model %s, effort %s" % (plan["model"] or "CLI default", plan["effort"] or "CLI default")
            if plan["cli"] == "claude" and plan.get("account"):
                how += ", account %s" % plan["account"]
        print("started %s %r (%s) in tmux %r at %s%s" % (plan["cli"], plan["name"], how, plan["tmux"], plan["path"],
                                                      (" on branch " + plan["branch"]) if plan.get("branch") else ""))
        if plan.get("route"):
            print("route: " + plan["route"])
        if plan.get("memory"):
            print("memory: " + plan["memory"])
    for note in plan.get("notes") or []:
        print("note: " + note)
    print("attach: tmux attach -t %s   (from another machine: ssh <this host> -t tmux attach -t %s)"
          % (plan["name"], plan["name"]))


def main(argv=None):
    cfg = config.load()
    a = parse_args(argv, cfg)
    brief = a.brief_text or (Path(a.brief).read_text() if a.brief else (piped.piped_text() or ""))
    brief = brief.strip()
    if not brief:
        die("no brief: pass --brief FILE, --brief-text TEXT, or pipe it on stdin")
    try:
        props = memcap.limits(cfg, a.memory_max, a.swap_max)
    except ValueError as e:
        die(str(e))
    plan = dict(memory_cap=memcap.describe(props), **plan_place(a, repos_root(cfg)))
    try:
        plan.update(plan_agent(a, cfg, plan))
    except CommandError as e:
        die(str(e))
    if a.dry_run:
        plan["brief_chars"] = len(brief)
        print(json.dumps(plan, indent=2))
        return 0
    if tmux_has(plan["name"]) and not a.reuse:
        die("tmux session %r already exists (use --reuse or --name)" % plan["name"], 3)
    try:
        make_place(a, plan)
        start_agent(plan, write_brief(a, cfg, plan, brief), props)
    except CommandError as e:
        die(str(e))
    report(a, plan, cfg["host_id"])
    if plan.get("error"):
        die(plan["error"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
