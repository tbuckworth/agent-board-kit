#!/usr/bin/env python3
"""agent-failover: move a Claude agent to another login when its own hits a usage limit mid-task, or while it is
idle once its login is used up for it, and up again, once idle, when a better login has headroom.

    agent-failover                                   # watch forever (systemd/agent-failover.service), and mail
                                                     # the owner while agents bill a login's extra usage
    agent-failover --once [--dry-run] [--json]       # one pass; --dry-run moves nothing, saves no state
    agent-failover move NAME_OR_ID --to LOGIN [--prompt TEXT] [--dry-run]   # move one agent now
    agent-failover status                            # agents it has moved: first login, current login, moves

Details: README.md, section "Login failover when an agent hits its limit"; settings: config key "failover"
(agentmail/failover.py DEFAULTS).
"""
import argparse
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import (accounts, alerts, claude_session, commands, config, failover, jsonfile,  # noqa: E402
                       outbound, registry, statuslog, usage, watch)
from agentmail.trust import claude_json_for, ensure_trust  # noqa: E402

IDLE_LOOK_SECONDS = 600   # between looks at the idle agents for a move (one_pass)


def trust():
    """The trust writer (agentmail/trust.py) for the login an agent moves to (its .claude.json)."""
    return lambda cwd, config_dir: ensure_trust(cwd, claude_json_for(config_dir))


def sample(f):
    """Every live Claude session and the movable ones among them (each with the model of its last reply, when its
    transcript shows one, and that reply's time, model_at), the limits the movable ones' transcripts show, and the
    limited ones that cannot move."""
    live, agents, limits, skipped = [], [], {}, {}
    for s in registry.claude_sessions():
        if not s["live"]:
            continue
        path = claude_session.transcript(s)
        lines = jsonfile.read_tail(path, f["tail_bytes"]) if path else []
        hit = failover.limit_hit(lines)
        model, at = claude_session.last_reply(lines)
        s = dict(s, model=model, model_at=usage.iso_epoch(at))
        live.append(s)
        pane, why = claude_session.movable(s)
        if not pane:
            if hit:
                skipped[s["id"]] = (s, why, hit)
            continue
        agents.append(s)
        if hit:
            limits[s["id"]] = hit
    return live, agents, limits, skipped


def with_owners(agents):
    """Each agent with its repo's GitHub owner (accounts.folder_owner), for the logins' owner rules. One whose owner
    git cannot tell is logged and left out of this pass, so no rule is skipped."""
    out = []
    for a in agents:
        try:
            owner = accounts.folder_owner(a.get("cwd"))
        except commands.CommandError as e:
            watch.log("%s (%s) not moved in this pass: %s" % (a.get("name") or "-", a["id"][:8], e))
            continue
        out.append(dict(a, owner=owner))
    return out


def log_move(sess, to, reason, ok, detail):
    """The failover event in the status log for a move that was tried (not a dry run), a failed one too."""
    statuslog.append({"cli": "claude", "session_id": sess["id"], "name": sess.get("name") or "",
                      "cwd": sess.get("cwd") or "", "event": "failover", "account": to,
                      "text": "%s -> %s (%s)%s" % (sess.get("account"), to, reason, "" if ok else ": FAILED " + detail[:200])})


def act(moves, notes, state, cfg, dry_run, now):
    """Try each move and log it; outside a dry run, record the moves that worked and the waits. Returns (state,
    {session id: the login it is on now} for each move that worked, or would have on a dry run)."""
    moved = {}
    for m in moves:
        sess = m["session"]
        who = "%s (%s)" % (sess.get("name") or "-", sess["id"][:8])
        ok, detail = failover.migrate(sess, m["to"], m["prompt"], cfg, trust=None if dry_run else trust(),
                                      dry_run=dry_run, why=m["reason"],
                                      overrides={"--model": m["model"]} if m.get("model") else None)
        watch.log("%s %s: %s -> %s, %s: %s" % ("would move" if dry_run else ("moved" if ok else "FAILED to move"),
                                               who, sess.get("account"), m["to"], m["reason"], detail))
        if ok:
            moved[sess["id"]] = m["to"]
        if dry_run:
            continue
        log_move(sess, m["to"], m["reason"], ok, detail)
        if ok:
            state = failover.record(state, m, now)
    for sid, key, text, event in notes:
        watch.log("waiting: " + text)
        if not dry_run:
            if event:
                statuslog.append({"cli": "claude", "session_id": sid, "event": event, "text": text[:300]})
            state.setdefault("sessions", {}).setdefault(sid, {})["stuck_until"] = key
    return state, moved


def report_spend(live, snaps, state, cfg, dry_run, now):
    """Mail the owner what failover.spend_watch has to say about extra usage, as a mailroom alert (alerts.send_alert),
    and keep each login's stretch in state "spend" once its mail is sent or there is none. A mail that fails is
    logged, and the login's stretch is left as it was, so the next check sends it again. A login whose spend cannot
    be checked is logged once per reason (state "spend_unreadable")."""
    ctx = outbound.Context(cfg)   # opens the store and Gmail on the first mail
    results, unreadable = failover.spend_watch(live, snaps, state, cfg, now)
    for login, why in sorted(unreadable.items()):
        if (state.get("spend_unreadable") or {}).get(login) != why:
            watch.log("extra-usage spend on %s not checked: %s" % (login, why))
    state["spend_unreadable"] = unreadable
    for login, stretch, mail in results:
        if mail and dry_run:
            watch.log("would mail %s: %s" % (cfg["owner_name"], mail[2]))
            continue
        if mail:
            try:
                sent = alerts.send_alert(ctx.svc, ctx.st, cfg, *mail)
            except Exception as e:  # noqa: BLE001 - Gmail or the store failing must not stop the moves
                watch.log("error: extra-usage mail about %s not sent, tried again at the next check: %s: %s" % (
                    login, type(e).__name__, e))
                continue
            watch.log(("mailed %s: %s" if sent else "not mailed to %s (alerts_enabled off, no owner address, or sent "
                                                    "already): %s") % (cfg["owner_name"], mail[2]))
        state = failover.keep_stretch(state, login, stretch)
    return state


def one_pass(cfg, state, dry_run, last, now):
    """One watch pass. last: when the idle agents were last looked at for a move (up, back, off a used-up login) and
    the spend check last ran ({"idle": epoch, "spend": epoch}). Usage is read only when an agent is limited, or one
    of those is due. A pass makes at most failover.idle_moves_per_pass idle moves (failover.pace)
    and, with some left and one of its own working, makes the idle agents' look due again at the next pass. Returns
    (state, moves, last)."""
    f = failover.settings(cfg)
    live, agents, limits, skipped = sample(f)
    for sid, (s, why, hit) in skipped.items():
        if (state.get("unmovable") or {}).get(sid) != failover.stuck_key(hit):
            watch.log("limit on %s (%s) but not moved: %s" % (s.get("name") or sid[:8], s.get("account"), why))
            if not dry_run:
                state.setdefault("unmovable", {})[sid] = failover.stuck_key(hit)
    idle = [a for a in agents if a.get("status") == "idle"]
    look = bool(f["switch_back"] and idle and now - last["idle"] >= IDLE_LOOK_SECONDS)
    spend = bool(f["spend_mail"] and (live or state.get("spend")) and now - last["spend"] >= f["spend_check_seconds"])
    if not (limits or look or spend):
        return state, [], last
    snaps = usage.snapshots(cfg)
    moves, notes = failover.decide(with_owners(agents), limits, snaps, state, cfg, now)
    moves, later = failover.pace(moves, f)
    if later:
        names = ["%s -> %s" % (m["session"].get("name") or m["session"]["id"][:8], m["to"]) for m in later]
        watch.log("%d idle move(s) left for the next pass (failover.idle_moves_per_pass: %d): %s" % (
            len(later), f["idle_moves_per_pass"], ", ".join(names)))
    state, moved = act(moves, notes, state, cfg, dry_run, now)
    if spend:   # each agent where this pass's moves left it
        live = [dict(x, account=moved.get(x["id"], x.get("account"))) for x in live]
        state = report_spend(live, snaps, state, cfg, dry_run, now)
    # with idle moves left, and one of this pass's working (not one failing again and again, and not a dry run, which
    # moves nothing), look again next pass
    again = later and not dry_run and any(m["session"]["id"] in moved for m in moves if m.get("idle"))
    return state, moves, {"idle": now - IDLE_LOOK_SECONDS if again else now if look else last["idle"],
                          "spend": now if spend else last["spend"]}


def cmd_watch(a):
    once = watch.once(a)
    f = failover.settings(config.load())
    last = {"idle": 0.0 if once else time.time() - IDLE_LOOK_SECONDS + 60, "spend": 0.0}
    if not f["enabled"] and not once:
        watch.log("disabled (config failover.enabled); idling")

    def step(state):
        nonlocal f, last
        cfg = config.load()
        f = failover.settings(cfg)
        if not (f["enabled"] or once):
            return state
        state, moves, last = one_pass(cfg, state, a.dry_run, last, time.time())
        if once and a.json:
            print(json.dumps([{"session": m["session"]["id"], "name": m["session"].get("name"),
                               "from": m["session"].get("account"), "to": m["to"], "reason": m["reason"]}
                              for m in moves], indent=1))
        elif once and not moves:
            print("nothing to move")
        return state
    return watch.run(a, step, failover.STATE, lambda: f["interval_seconds"])


def cmd_move(a):
    cfg = config.load()
    s = usage.settings(cfg)
    try:
        cli, acct = usage.parse_target(a.to, s)
    except ValueError as e:
        print("agent-failover: %s" % e, file=sys.stderr)
        return 1
    if cli != "claude":
        print("agent-failover: a Claude session can only move to another Claude login", file=sys.stderr)
        return 1
    sess, code, _ = registry.resolve(a.target, "claude")
    if code != 0 or not sess.get("live"):
        print("agent-failover: no live Claude session %r" % a.target, file=sys.stderr)
        return 4
    if sess.get("account") == acct:
        print("agent-failover: %s is already on %s" % (a.target, acct), file=sys.stderr)
        return 1
    move = {"session": sess, "to": acct, "reason": "by hand", "prompt": a.prompt, "resets_at": None}
    ok, detail = failover.migrate(sess, acct, a.prompt, cfg, trust=None if a.dry_run else trust(), dry_run=a.dry_run)
    print(detail)
    if not a.dry_run:
        log_move(sess, acct, move["reason"], ok, detail)
    if ok and not a.dry_run:
        failover.STATE.write(failover.record(failover.STATE.read(), move, time.time()))
    return 0 if ok else 1


def cmd_status(a):
    # an agent switched by hand, or only ever waiting, has a record but no moves
    st = {sid: e for sid, e in (failover.STATE.read().get("sessions") or {}).items() if e.get("moves")}
    if not st:
        print("no agent has been moved")
        return 0
    def place(login, model):
        return (login or "-") + (" (%s)" % model if model else "")
    for sid, e in sorted(st.items(), key=lambda kv: -failover.last_move(kv[1])):
        at, _, _, reason = e["moves"][-1]
        print("%-30s %s  first login %-28s now %-28s last move %s: %s" % (
            e.get("name") or "-", sid[:8], place(e.get("home"), e.get("home_model")),
            place(e.get("current"), e.get("model")), time.strftime("%m-%d %H:%M", time.localtime(at)), reason))
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] == ["move"]:
        ap = argparse.ArgumentParser(prog="agent-failover move")
        ap.add_argument("target")
        ap.add_argument("--to", required=True, help="Claude login from config usage.claude_accounts")
        ap.add_argument("--prompt", help="message to resume it with (default: none, it waits for input)")
        ap.add_argument("--dry-run", action="store_true")
        return cmd_move(ap.parse_args(argv[1:]))
    if argv[:1] == ["status"]:
        return cmd_status(None)
    ap = argparse.ArgumentParser(prog="agent-failover", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    watch.add_options(ap, "move nothing, save no state")
    return cmd_watch(ap.parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
