#!/usr/bin/env python3
"""agent-usage: plan usage left on each Claude and Codex account, and which one a new agent should use.

    agent-usage [--json] [--refresh] [--repo PATH] [--cli claude|codex]
    agent-usage --pick [--repo PATH] [--cli claude|codex]     # just the target, e.g. claude:work or codex
    agent-usage init-account NAME --config-dir DIR [--copy-mcp a,b] [--dry-run]

Percentages are REMAINING, as each provider's server reports them, read through the CLIs themselves:
Claude Code answers a `get_usage` control request (what /usage shows) and Codex's app-server answers
account/rateLimits/read (what /status shows). Neither sends a prompt, so no quota is spent; about 2 s per
account, in parallel, then cached for 2 minutes. No token or credential is read, printed or stored here.

The recommendation takes accounts in config order (usage.order) and picks the first whose 5-hour and weekly
windows (and the weekly window of the model agents run, if there is one) all keep at least usage.min_remaining
percent. --repo applies per-account exclude_owners/only_owners to that repo's GitHub owner.

init-account prepares a second Claude login: a new config dir that shares CLAUDE.md, settings, skills, hooks
and plugins with ~/.claude by symlink, and keeps credentials, sessions and transcripts separate. You then log
in yourself: CLAUDE_CONFIG_DIR=DIR claude, then /login. Settings: config key "usage", agentmail/usage.py.
"""
import argparse
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import config, usage  # noqa: E402


def resolve_repo(repo, cfg):
    """A path as given, or a bare repo name under repos_root (as agent-spawn --repo takes it)."""
    p = Path(repo).expanduser()
    if p.exists() or "/" in repo:
        return p
    return Path(str(cfg.get("repos_root") or "~/code")).expanduser() / repo


def cmd_report(a):
    cfg = config.load()
    snaps = usage.snapshots(cfg, refresh=a.refresh)
    owner = usage.repo_owner(resolve_repo(a.repo, cfg)) if a.repo else None
    rec = usage.recommend(snaps, cfg, owner=owner, only_cli=a.cli)
    if a.pick:
        print(rec["use"] or "")
        return 0 if rec["use"] else 1
    if a.json:
        s = usage.settings(cfg)
        print(json.dumps({"generated_at": time.time(), "accounts": [snaps[t] for t in usage.targets(s) if t in snaps],
                          "recommendation": rec}, indent=2))
        return 0
    print(usage.render_text(snaps, rec, cfg))
    return 0


def cmd_init(a):
    if a.name in ("codex", "auto", "claude"):
        print("agent-usage: %r is reserved; pick another account name" % a.name, file=sys.stderr)
        return 1
    mcp = [m.strip() for m in (a.copy_mcp or "").split(",") if m.strip()]
    try:
        done = usage.init_account(a.config_dir, copy_mcp=mcp, dry_run=a.dry_run)
    except (ValueError, OSError) as e:
        print("agent-usage: %s" % e, file=sys.stderr)
        return 1
    d = str(Path(a.config_dir).expanduser().resolve())
    for line in done or ["nothing to do: %s is already set up" % d]:
        print(("would " if a.dry_run else "") + line)
    s = usage.settings(config.load())
    dflt = usage.default_account(s) or "personal"
    accts = {n: v for n, v in s["claude_accounts"].items() if n != a.name}
    accts.setdefault(dflt, {"config_dir": None})
    snippet = {"usage": {"claude_accounts": dict({a.name: {"config_dir": d, "label": a.name}}, **accts),
                         "order": ["claude:" + a.name] + ["claude:" + n for n in accts] + ["codex"]}}
    print("\nNext steps (you, not an agent):\n"
          "  1. CLAUDE_CONFIG_DIR=%s claude      # pick a theme, then /login with the %s account\n"
          "  2. set in ~/.config/agent-mail/config.json (rename the default login's account if you like):\n"
          "     %s\n"
          "  3. agent-usage --refresh            # both Claude accounts should now show numbers"
          % (d, a.name, json.dumps(snippet)))
    if not mcp:
        print("  4. optional, after the login: agent-usage init-account %s --config-dir %s --copy-mcp gmail,google-docs\n"
              "     (user-scope MCP servers live in each account's .claude.json and are not shared)" % (a.name, d))
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] == ["init-account"]:
        ap = argparse.ArgumentParser(prog="agent-usage init-account")
        ap.add_argument("name")
        ap.add_argument("--config-dir", required=True)
        ap.add_argument("--copy-mcp", help="comma-separated user MCP server names to copy from ~/.claude.json (after login)")
        ap.add_argument("--dry-run", action="store_true")
        return cmd_init(ap.parse_args(argv[1:]))
    ap = argparse.ArgumentParser(prog="agent-usage", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--refresh", action="store_true", help="ignore the cache and read every account now")
    ap.add_argument("--pick", action="store_true", help="print only the recommended target")
    ap.add_argument("--repo", help="the repo the agent will work on (account owner rules)")
    ap.add_argument("--cli", choices=["claude", "codex"], help="recommend only among this CLI's accounts")
    return cmd_report(ap.parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
