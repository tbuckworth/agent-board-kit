#!/usr/bin/env python3
"""agent-orchestrate: run the orchestrator once, on one event, with a fresh context.

    agent-orchestrate [--source LABEL] [--json] "event text"   # or the text on stdin; LABEL: mail, peer, manual
    agent-orchestrate [--source LABEL] --input-json < event.json   # {"text": ..., "files": [{"name", "data"}]}
    agent-orchestrate --runs [--limit N]      # recent runs: cost, turns, outcome
    agent-orchestrate --show-command          # the claude command an event runs

The event runs on the first that takes it: the Claude logins and Codex in usage.order, then the API key that config
orchestrator_fallback_secret names (agentmail/headless.py logins). Details: README.md, section "The orchestrator".
"""
import argparse
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import config, mailbox, orchestrate, piped, replyfiles  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agent-orchestrate", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("text", nargs="*")
    ap.add_argument("--source", default="manual", help="label for the run log (mail, peer, manual)")
    ap.add_argument("--runs", action="store_true", help="list recent runs")
    ap.add_argument("--limit", type=int, default=20)
    ap.add_argument("--show-command", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--input-json", action="store_true",
                    help='read the event and its files from stdin, {"text": TEXT, "files": [{"name": NAME, "data": '
                         'BASE64}, ...]} as a Mail-tab reply gives them: the files are saved, as config owner_name\'s, '
                         'and the event ends with their paths')
    a = ap.parse_args(argv)
    cfg = config.load()

    if a.show_command:
        print(" ".join(orchestrate.command(cfg)), "  (cwd %s, prompt on stdin)" % cfg.get("orchestrator_dir"))
        return 0
    if a.runs:
        runs = orchestrate.logged_runs()
        for r in runs[-a.limit:]:
            ts = time.strftime("%m-%d %H:%M", time.localtime(r.get("ts", 0)))
            cost = ("$%.3f" % r["cost"]) if isinstance(r.get("cost"), (int, float)) else "-"
            print("%s %-6s %-4s %-9s %7s %3s turns %6ss  %s" % (
                ts, r.get("source", ""), "ok" if r.get("ok") else "FAIL", r.get("auth") or "-", cost, r.get("turns") or "-",
                r.get("duration_s") or "-", (r.get("error") or r.get("result") or "").replace("\n", " ")[:90]))
        total = sum(r["cost"] for r in runs if isinstance(r.get("cost"), (int, float)))
        print("total logged cost: $%.2f over %d runs" % (total, len(runs)))
        return 0

    files = []
    if a.input_json:
        if a.text:
            print("agent-orchestrate: with --input-json the event is in the JSON on stdin, not on the command line",
                  file=sys.stderr)
            return 1
        try:
            text, files = mailbox.piped_input("the message")
        except mailbox.MailError as e:
            print("agent-orchestrate: --input-json: %s" % e, file=sys.stderr)
            return 1
        text = text.strip()
    else:
        text = " ".join(a.text).strip()
        if not text:
            text = (piped.piped_text() or "").strip()       # only what was piped in: never the tool's open socket
    if not text and not files:
        print("agent-orchestrate: no event text", file=sys.stderr)
        return 1
    if files:
        text = replyfiles.with_lines(text, replyfiles.attach(replyfiles.FILES_DIR, files, cfg["owner_name"]))
    info = orchestrate.run_event(text, a.source, cfg)
    if a.json:
        print(json.dumps(info, indent=2))
    else:
        print("%s · $%s · %s turns · %ss" % ("ok" if info["ok"] else "FAILED", info["cost"], info["turns"], info["duration_s"]))
        print(info["result"] if info["ok"] else info["error"])
    return 0 if info["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
