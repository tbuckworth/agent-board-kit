#!/usr/bin/env python3
"""agent-memwatch: warn the agents holding the most memory before the machine runs out.

    agent-memwatch [--interval SECONDS]          # run forever (systemd/agent-memwatch.service)
    agent-memwatch --once [--dry-run] [--json]   # one sample; --dry-run sends nothing and saves no state

Details: README.md, section "Memory watch"; settings: config key "memwatch" (agentmail/memwatch.py DEFAULTS).
"""
import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agentmail import config, jsonfile, memwatch, registry, watch  # noqa: E402

BIN = Path(__file__).resolve().parent
# What memwatch.decide keeps. Deleting it when damaged only resets the repeat limits.
STATE = jsonfile.JsonFile(config.STATE_DIR / "memwatch.json", jsonfile.PLAIN, None)


def sample():
    u = memwatch.usage(memwatch.meminfo())
    procs = memwatch.processes()
    sessions = registry.all_sessions()
    own = memwatch.owners(procs, memwatch.session_pids(sessions, procs), sessions)
    caps = []
    for g in own:
        for cg in sorted(g["cgroups"]) if g["session"] else ():
            leaf = cg.rsplit("/", 1)[-1]
            if leaf.startswith("agent-") and leaf.endswith(".scope"):
                cur, mx = memwatch.cgroup_limits(cg)
                if cur is not None and mx:
                    caps.append((g, cur, mx))
    return u, own, caps


def act(actions, cfg):
    """Send each of memwatch.decide's actions: a ping through agent-send, the email through agent-mail. Logs each
    with its exit code; returns the keys of those that went (exit 0), for memwatch.record."""
    done = []
    for a in actions:
        if a[0] == "ping":
            g, lvl, text = a[1], a[2], a[3]
            r = subprocess.run([str(BIN / "agent-send"), "--from", "agent-memwatch", g["session"]["id"], text],
                               capture_output=True, text=True, timeout=60)
            watch.log("ping %s (%s, level %s): exit %s %s" % (g["label"], memwatch.gb(g["mem"]), lvl, r.returncode,
                                                               (r.stdout + r.stderr).strip()[-160:]))
        else:
            to = config.alert_address(cfg)
            if not to:
                watch.log("email %r not sent: config has no alert_to, owner_email or allowlist" % a[1])
                continue
            # agent-mail runs under this interpreter, the kit's venv, which holds the Google client libraries
            r = subprocess.run([sys.executable, str(BIN / "agent-mail"), "send", "--unrouted", "--to", to,
                                "--subject", "[agent-memwatch] " + a[1]], input=a[2],
                               capture_output=True, text=True, timeout=120)
            watch.log("email %r: exit %s %s" % (a[1], r.returncode, (r.stdout + r.stderr).strip()[-160:]))
        if r.returncode == 0:
            done.append(a[-1])
    return done


def report(u, own, caps, actions, as_json, s):
    if as_json:
        print(json.dumps({"usage": u, "level": memwatch.level(u, s),
                          "owners": [{"label": g["label"], "session": (g["session"] or {}).get("id"), "mem": g["mem"],
                                      "top": g["top"]} for g in own[:15]],
                          "caps": [{"label": g["label"], "current": c, "max": m} for g, c, m in caps],
                          "actions": [a[0] if a[0] == "email" else "ping %s level %s" % (a[1]["label"], a[2])
                                      for a in actions]}, indent=1))
        return
    print(memwatch.headline(u))
    print(memwatch.table(own, 12))
    for g, c, m in caps:
        print("cap: %s at %s of %s" % (g["label"], memwatch.gb(c), memwatch.gb(m)))
    for a in actions:
        print("would " + ("email %s: %s" % (s["owner_name"], a[1]) if a[0] == "email" else
                          "message %s (level %s):\n  %s" % (a[1]["label"], a[2], a[3])))


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agent-memwatch", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    watch.add_options(ap, "send nothing, save no state")
    ap.add_argument("--interval", type=float, help="seconds between samples (default: config)")
    a = ap.parse_args(argv)
    cfg = config.load()
    s = memwatch.settings(cfg)
    once = watch.once(a)
    last_level = None

    def step(state):
        nonlocal last_level
        u, own, caps = sample()
        now = time.time()
        actions, new_state = memwatch.decide(state, u, own, caps, s, now)
        lvl = memwatch.level(u, s)
        if once:
            report(u, own, caps, actions, a.json, s)
        elif lvl != last_level and (lvl or last_level):
            watch.log("level %s: %s" % (lvl, memwatch.headline(u)))
        last_level = lvl
        if a.dry_run:
            return new_state
        return memwatch.record(new_state, act(actions, cfg), now)
    return watch.run(a, step, STATE, lambda: a.interval or s["interval_seconds"])


if __name__ == "__main__":
    sys.exit(main())
